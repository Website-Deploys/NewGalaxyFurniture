---
/**
 * The related products section.
 *
 * It renders nothing at all — no heading, no container, no rule — when the set is empty.
 * Requirement 4.9 is explicit that this is the correct outcome and not a degradation: an empty
 * related section is preferable to a rail of unrelated furniture, and a heading with nothing under
 * it is the visual equivalent of the unrelated rail.
 *
 * The cards are `ProductCard`, not a bespoke variant, so a related product looks and behaves
 * exactly as it does everywhere else — including its own Quick Enquire target. None of these
 * images is eager: the PDP's one eager image is the gallery primary.
 *
 * Requirements: 4.8, 4.9, 15.17.
 */
import ProductCard from '@/components/product/ProductCard.astro';
import type { Product } from '@/schemas/product';

interface Props {
  products: readonly Product[];
  categoryNames?: Record<string, string>;
  heading?: string;
  /** Optional "explore more" link shown beside the heading — e.g. the category listing. */
  explore?: { href: string; label: string };
}

const {
  products,
  categoryNames = {},
  heading = 'You might also like',
  explore,
} = Astro.props;
---

{
  products.length > 0 && (
    <section class="ngf-pdp-section" aria-labelledby="ngf-related-heading" data-ngf-related>
      <div class="ngf-related-head">
        <h2 id="ngf-related-heading">{heading}</h2>
        {explore !== undefined && (
          <a class="ngf-related-explore" href={explore.href}>
            {explore.label}
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M2 8h11M9 4l4 4-4 4" />
            </svg>
          </a>
        )}
      </div>
      <ul class="ngf-grid" data-reveal data-motion-group>
        {products.map((product) => (
          <li>
            <ProductCard product={product} categoryName={categoryNames[product.category]} />
          </li>
        ))}
      </ul>
    </section>
  )
}
