---
/**
 * The product detail body — one component, two callers.
 *
 * Requirement 12.9 says preview must render "using the same components that render the public
 * product detail page". The only way that holds over time is for there to be exactly one
 * component, so this is it: `/admin/preview/:id` renders it against the KV draft, and the public
 * `/product/{slug}` route renders it against the baked catalogue. Neither owns it, and there is no
 * preview-only markup anywhere — a divergence between what an operator approves and what a
 * customer sees would make preview worthless.
 *
 * Task 15 did not fork this component; it **decomposed** it. The breadcrumbs, price block, stock
 * badge, spec list, and variant list moved into their own components (Requirement 4.2 names them
 * as distinct blocks and the task list names the files), and this component composes them. So the
 * public page gains nothing preview lacks, and preview gains every fix the public page gets.
 *
 * The one thing the two callers genuinely differ on is the **gallery**. The public PDP mounts the
 * interactive `Gallery` island — thumbnail rail, swipe, zoom, keyboard — and preview has no need
 * of an island to approve a photograph. So the gallery is a **named slot**: a caller that supplies
 * one gets theirs, and a caller that does not gets the static sequence below, which is the same
 * images in the same order through the same `ResponsiveImage`. Not a second gallery — a fallback
 * rendering of the same content.
 *
 * What is still deliberately **not** here: the page shell, the metadata, the structured data,
 * related products, and recently viewed. Those are the public page's concerns; preview does not
 * need them and must not simulate them.
 *
 * Requirements: 4.2, 4.3, 4.12, 5.1–5.8, 5.20, 12.9, 15.10, 15.17.
 */
import Breadcrumbs from '@/components/product/Breadcrumbs.astro';
import { safeText, safeTextOrUndefined } from '@/lib/security/sanitize';
import { productCrumbs } from '@/lib/site/breadcrumbs';
import PriceBlock from '@/components/product/PriceBlock.astro';
import SpecList from '@/components/product/SpecList.astro';
import StockBadge from '@/components/product/StockBadge.astro';
import VariantList from '@/components/product/VariantList.astro';
import CallLink from '@/components/ui/CallLink.astro';
import ResponsiveImage from '@/components/ui/ResponsiveImage.astro';
import WhatsAppLink from '@/components/ui/WhatsAppLink.astro';
import { getSiteSettings } from '@/lib/content/site';
import { NUMBERS_CAPTION } from '@/lib/site/contact';
import { buildEnquiryMessage, buildWhatsAppUrl } from '@/lib/whatsapp';
import { primaryImageOf, type Product } from '@/schemas/product';

interface Props {
  product: Product;
  /** The category's display name, when it is known. Falls back to the slug. */
  categoryName?: string;
  /** The canonical PDP URL, carried into the enquiry message when it is known. */
  productUrl?: string;
  /**
   * True when the caller fills the `gallery` slot.
   *
   * Declared rather than sniffed with `Astro.slots.has('gallery')`, and that is not fussiness: a
   * caller writing `{images.length > 0 && <Gallery slot="gallery" />}` registers the slot as
   * *present* even when the expression renders nothing, so `has()` reports `true` for a product
   * with no photographs and the static fallback below is skipped — leaving an empty media column.
   * That was a real defect, caught by building a product with no images. An explicit boolean
   * cannot be wrong about it.
   */
  gallerySlot?: boolean;
}

const { product, categoryName, productUrl, gallerySlot } = Astro.props;
const settings = getSiteSettings();

/*
 * Every operator-supplied string this component renders, sanitized once (Requirement 25.2,
 * Property 55). Sanitizing here rather than at each interpolation matters because three of these
 * values do not end up as text nodes: the name goes into `data-ngf-product-name`, which an island
 * reads back, and into an `aria-label`.
 *
 * `safeText` is the identity on ordinary prose and preserves paragraph breaks, so descriptions read
 * exactly as they were written.
 */
const name = safeText(product.name);
const sku = safeText(product.sku);
const description = safeText(product.description);
const customization = safeTextOrUndefined(product.customization);
const deliveryInformation = safeTextOrUndefined(product.deliveryInformation);

const primary = primaryImageOf(product);
const gallery = [...product.images].sort((a, b) => a.order - b.order);
const rest = gallery.filter((image) => image.id !== primary?.id);
const hasGallerySlot = gallerySlot ?? Astro.slots.has('gallery');

/**
 * Requirement 4.12: an out-of-stock product keeps both controls, presented as an availability
 * enquiry. The controls are relabelled and nothing else changes — the destination, the message,
 * and the tap targets are identical, because removing, hiding, or disabling either one is exactly
 * what the requirement forbids.
 *
 * The message itself needs no branch: `buildEnquiryMessage` already asks about "price,
 * availability and order details", which is the right sentence in both cases.
 */
const outOfStock = product.stockStatus === 'OUT_OF_STOCK';
const whatsappLabel = outOfStock
  ? 'Ask about availability on WhatsApp'
  : 'Order or Enquire on WhatsApp';
const callLabel = outOfStock ? 'Call about availability' : 'Call about this piece';

const enquiryContext = {
  kind: 'product' as const,
  productName: product.name,
  sku: product.sku,
  ...(productUrl === undefined ? {} : { productUrl }),
};

/**
 * Quick Enquire, as the same progressively-enhanced link the product card uses.
 *
 * Base layer: a WhatsApp URL carrying the product name and SKU. Enhanced layer: the public PDP
 * mounts `QuickEnquireHost`, which intercepts the click and opens the enquiry form in place
 * (Requirement 6.1 — Quick Enquire opens "from a product card or PDP without navigating away").
 * `/admin/preview/:id` mounts no host, so there the control resolves to the link — which is the
 * correct behaviour for a preview screen and not a degradation of it.
 */
const quickEnquireHref = (() => {
  const number = settings.whatsapp[0];
  if (number === undefined) return null;
  return buildWhatsAppUrl(number.e164, buildEnquiryMessage(enquiryContext, settings));
})();
---

<article
  class="ngf-pdp-showroom"
  data-product={product.slug}
  data-stock={product.stockStatus}
>
  {
    /*
    The gallery column. The interactive island fills the `gallery` slot on the public page; the
    admin-preview caller supplies no slot and gets the static sequence below — the same images in
    the same order, framed by the same drawing-board panel so the two callers read alike.
  */
  }
  <div class="ngf-pdp-media" data-reveal="mask">
    {
      hasGallerySlot ? (
        <slot name="gallery" />
      ) : primary === null ? (
        <div class="ngf-pdp-media-empty">No photograph yet</div>
      ) : (
        <>
          <ResponsiveImage productId={product.id} image={primary} context="galleryPrimary" />
          {rest.length > 0 && (
            <ul class="ngf-pdp-media-thumbs">
              {rest.map((image) => (
                <li>
                  <ResponsiveImage
                    productId={product.id}
                    image={image}
                    context="galleryThumb"
                    widths={[320]}
                  />
                </li>
              ))}
            </ul>
          )}
        </>
      )
    }
  </div>

  {
    /*
    The information panel: a large rounded white card, the light-showroom card language. Every
    block below renders only when the field it names holds a value — the omit-when-empty rule
    (Requirement 4.3) lives in the decomposed components, not restated here.
  */
  }
  <div class="ngf-pdp-info" data-reveal data-motion-group>
    {
      /* The one trail: the same array the PDP serialises as `BreadcrumbList` (Requirement 23.10). */
    }
    <Breadcrumbs items={productCrumbs(product, categoryName)} />

    <header class="ngf-pdp-head">
      <h1 class="ngf-pdp-name">{name}</h1>
      <p class="ngf-pdp-sku">SKU {sku}</p>
    </header>

    <div class="ngf-pdp-priceline">
      <PriceBlock
        price={product.price}
        priceOnEnquiry={product.priceOnEnquiry}
        originalPrice={product.originalPrice}
        discount={product.discount}
      />
      <StockBadge status={product.stockStatus} />
    </div>

    {
      /*
      The conversion controls, through the shared link components — so the destinations are built
      by `buildWhatsAppUrl`/`buildTelUrl` from `buildEnquiryMessage` and long-press, middle-click,
      and copy-link all resolve to what activation resolves to (Requirement 5.11).
    */
    }
    <div class="ngf-pdp-actions">
      <div class="ngf-pdp-cta-row">
        <WhatsAppLink
          context={enquiryContext}
          label={whatsappLabel}
          variant="solid"
          class="ngf-pdp-cta"
        />
        <CallLink
          label={callLabel}
          variant="outline"
          number={settings.phone[0]}
          class="ngf-pdp-cta"
        />
        {
          quickEnquireHref !== null && (
            <a
              href={quickEnquireHref}
              target="_blank"
              rel="noopener"
              class="ngf-pdp-quick"
              data-ngf-quick-enquire
              data-ngf-product-slug={product.slug}
              data-ngf-product-name={name}
              aria-label={`Quick enquire about ${name}`}
            >
              Quick Enquire
            </a>
          )
        }
      </div>
      <p class="ngf-pdp-numbers">{NUMBERS_CAPTION}</p>
    </div>

    {
      description.trim() !== '' && (
        <div class="ngf-pdp-description whitespace-pre-line">{description}</div>
      )
    }

    {
      /*
      The specification area, framed as a drawing-board panel — the same cream ground and faint
      hairline grid the catalogue heroes use. The dimension annotation only ever states the values
      the product actually carries; a piece with no dimensions gets the panel's decorative grid and
      corner ticks and no invented numbers.
    */
    }
    <section class="ngf-pdp-specpanel" aria-label="Specifications">
      <p class="ngf-pdp-eyebrow">Specifications</p>
      <SpecList product={product} class="ngf-pdp-specs" />
    </section>

    <VariantList variants={product.variants} class="ngf-pdp-variants" />

    {
      product.madeToOrder && (
        <p class="ngf-pdp-mto">Made to order. Ask about timelines when you enquire.</p>
      )
    }

    {
      customization !== undefined && (
        <section class="ngf-pdp-note">
          <p class="ngf-pdp-eyebrow">Customization</p>
          <p class="ngf-pdp-note-body whitespace-pre-line">{customization}</p>
        </section>
      )
    }

    {
      deliveryInformation !== undefined && (
        <section class="ngf-pdp-note">
          <p class="ngf-pdp-eyebrow">Delivery</p>
          <p class="ngf-pdp-note-body whitespace-pre-line">{deliveryInformation}</p>
        </section>
      )
    }
  </div>
</article>
