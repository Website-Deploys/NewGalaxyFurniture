---
/**
 * The homepage hero — a full-width two-column layout: the copy on the LEFT (eyebrow, positioning
 * line, sub, CTAs, assurances) and one large showroom photograph on the RIGHT in its own rounded
 * panel. The two are real grid columns, so each side owns its width and the hero uses the full
 * content width rather than a single image with copy floated over its corner.
 *
 * Everything Requirements 7.3, 7.4, 7.5, 7.6, 7.11, and 7.12 pin down, and why each is structured
 * the way it is:
 *
 * - **The positioning line is the `<h1>`, and the brand mark is not.** The operator's line is the
 *   page's subject; the wordmark is a small eyebrow sibling so a visitor arriving from a search
 *   result sees who they have landed on, without the logotype pretending to be the heading.
 * - **Exactly two CTAs** — a loud primary (Explore the collection) and a quiet secondary (Custom
 *   furniture). WhatsApp and Call stay one tap away everywhere else (the header enquiry control, the
 *   WhatsApp band below, the sticky mobile action bar), so the hero stays uncluttered.
 * - **Exactly one image, and it is the largest painted element.** One `<img>` filling the right
 *   panel as its ground, with its intrinsic width and height emitted so the box is reserved before a
 *   byte arrives (7.4, 15.10). The panel's `aspect-ratio` reserves the box and the LQIP fills it
 *   until the photograph decodes, so nothing shifts (7.12). It is the largest painted element from
 *   320 px to 1920 px.
 * - **No video. Anywhere** (7.5).
 * - **Two parallax planes, transform and opacity only** (7.6, 21.8).
 * - **Reduced motion renders the final drawn state on first paint** (7.11).
 *
 * **Two columns, not an overlay.** The copy is a real grid column beside the image, not floated on
 * top of it, so no fade is needed to keep it legible — the previous single-panel design carried a
 * left white wash for exactly that reason, and it is gone with the overlay it served. On a phone the
 * grid collapses to one column with the copy first and the visual stacked beneath it.
 *
 * **The assurance row states nothing the operator has not supplied.** "Custom sizes and finishes"
 * and "Direct from the workshop" are the operator's own homepage sections restated as a line; the
 * delivery line is `settings.serviceArea` verbatim, and it renders only when that array is
 * non-empty. There is no lead time, no price, no capacity, and no history here (7.10).
 *
 * **On the image asset.** The hero paints the operator-supplied showroom photograph
 * (`settings.heroImage` → `/brand/hero.png`) as its dominant visual. When one is *not* supplied the
 * page passes a real product photograph as `showcase`, and failing that this falls back to the
 * project's own hairline room composition. Whichever it is, the homepage preloads the exact
 * resolution the hero paints (22.10).
 *
 * Requirements: 7.3, 7.4, 7.5, 7.6, 7.8, 7.10, 7.11, 7.12, 15.10, 15.11, 24.3.
 */
import TextReveal from '@/components/motion/TextReveal.astro';
import { getSiteSettings } from '@/lib/content/site';
import { loadingAttributes } from '@/lib/images/staging';
import { heroImageOf } from '@/lib/site/hero-image';
import type { HomepageSection } from '@/schemas/homepage';

interface HeroShowcaseImage {
  src: string;
  width: number;
  height: number;
  alt: string;
  lqip?: string;
  srcset: string;
  sizes: string;
}

interface HeroSlide {
  src: string;
  width: number;
  height: number;
  alt: string;
  lqip?: string;
  srcset?: string;
  sizes?: string;
}

interface Props {
  section: HomepageSection;
  /** The positioning line in force — `effectiveTagline(settings, homepage)`. */
  tagline: string | null;
  /**
   * A real product photograph to carry the hero when no `settings.heroImage` is supplied, resolved
   * by the page from the published catalogue. `null` when the operator has supplied a hero
   * photograph (which wins) or when the catalogue has none (the composition answers instead).
   */
  showcase?: HeroShowcaseImage | null;
  /**
   * The carousel's slides, built by the page: slide 1 is the prepared opening frame (the supplied
   * `hero.png`, else the showcase, else the composition), followed by real published product
   * photographs. Absent or single-entry → the hero is the static single image it always was.
   */
  slides?: HeroSlide[];
}

const { section, tagline, showcase = null, slides } = Astro.props;
const settings = getSiteSettings();

/*
 * The hero image. The operator's supplied showroom photograph wins; otherwise the page's product
 * showcase; otherwise the designed composition. `heroImageOf` answers the first and third, and the
 * page decides whether to pass a `showcase` (it passes `null` whenever a hero image is supplied).
 */
const supplied = heroImageOf(settings);
const image = supplied.supplied ? supplied : (showcase ?? supplied);
/*
 * "Photo" means the panel paints a real photograph edge to edge (cover) with the fade over it;
 * "composition" means the hairline fallback drawing, which is contained on cream with no fade. The
 * supplied hero photo and a product showcase are both photos; only the `HERO_COMPOSITION` fallback
 * (never supplied, never a showcase) is a composition.
 */
const isPhoto = supplied.supplied || showcase !== null;

/*
 * The slides to paint. When the page supplied a list, use it; otherwise fall back to the single
 * `image` the hero resolved, so the component still renders standalone. The composition fallback is
 * never carouselled — a hairline drawing is not a product photograph — so it stays a single slide.
 */
const firstFallback: HeroSlide = {
  src: image.src,
  width: image.width,
  height: image.height,
  alt: image.alt,
  ...(image.lqip === undefined ? {} : { lqip: image.lqip }),
  ...(showcase !== null ? { srcset: showcase.srcset, sizes: showcase.sizes } : {}),
};
const heroSlides: HeroSlide[] =
  isPhoto && slides !== undefined && slides.length > 0 ? slides : [firstFallback];
const isCarousel = heroSlides.length > 1;
const loading = loadingAttributes({ priority: true });

const ctaLabel = section.ctaLabel ?? 'Explore the collection';
const ctaHref = section.ctaHref ?? '/collection';

/**
 * The three assurances, as an inline icon row beneath the CTAs. Each one restates something already
 * supplied — two of the operator's own homepage sections and `settings.serviceArea` — so the row
 * adds emphasis, never a new claim. The delivery line renders only when `serviceArea` is non-empty,
 * and it sits in the middle to match the reference's order (sizes · delivery · workshop). The `icon`
 * selects a small hairline glyph drawn in the markup below; it carries no text of its own.
 */
const assurances: { icon: 'ruler' | 'truck' | 'hammer'; label: string }[] = [
  { icon: 'ruler', label: 'Custom sizes and finishes' },
  ...(settings.serviceArea.length > 0
    ? [{ icon: 'truck' as const, label: `Delivered across ${settings.serviceArea.join(', ')}` }]
    : []),
  { icon: 'hammer', label: 'Direct from the workshop' },
];

/** The heading's lines are the operator's own line breaks, exactly as `TextReveal` requires. */
const headingLines =
  tagline === null
    ? []
    : tagline
        .split('\n')
        .map((line) => line.trim())
        .filter((line) => line !== '');
---

<section
  class="ngf-hero"
  aria-labelledby="ngf-hero-heading"
  data-ngf-section="hero"
  data-hero-mode={isPhoto ? 'photo' : 'composition'}
  data-parallax-root
>
  {
    /*
    A full-bleed hero: one large showroom photograph runs edge to edge and up under the floating
    header as the section's ground, and the copy is overlaid on the LEFT over a cream-to-transparent
    scrim that keeps it legible against the image. The image is painted first (the background plane),
    the copy second (the foreground plane); on a phone the same image still fills the section behind
    the copy, with a stronger scrim so the text stays readable over a busy photograph.
  */
  }
  <div class="ngf-hero-inner">
    {
      /*
      Plane 1 — the photograph, the full-bleed background of the whole hero. When there is more than
      one slide the figure holds them stacked, each absolutely filling the same box, crossfaded by
      opacity only — so every slide occupies the identical area and nothing reflows between them (no
      layout shift). Slide 0 is the prepared opening frame: visible on first paint, eager and
      high-priority, and it is the image the page preloads. The rest are lazy and start transparent,
      decoded off the critical path, so a long collection never hurts LCP.

      The `.ngf-hero-figure` class and the intrinsic width/height on each `<img>` keep the box
      reserved for the image-loading audit and for CLS.
    */
    }
    <div
      class="ngf-hero-panel"
      data-ngf-carousel={isCarousel ? 'true' : undefined}
      data-hero-count={heroSlides.length}
    >
      <figure
        class="ngf-hero-figure ngf-hero-plane"
        data-parallax-plane="1"
        style={`--plane-depth: 0.15;${
          heroSlides[0]?.lqip === undefined ? '' : `background-image:url(${heroSlides[0].lqip});`
        }`}
        data-has-lqip={heroSlides[0]?.lqip === undefined ? 'false' : 'true'}
        aria-hidden={isPhoto ? undefined : 'true'}
      >
        {
          heroSlides.map((slide, index) => (
            <img
              class="ngf-hero-slide"
              src={slide.src}
              srcset={slide.srcset}
              sizes={slide.sizes}
              width={slide.width}
              height={slide.height}
              alt={slide.alt}
              loading={index === 0 ? loading.loading : 'lazy'}
              fetchpriority={index === 0 ? loading.fetchpriority : 'auto'}
              decoding={index === 0 ? loading.decoding : 'async'}
              data-ngf-hero-image={index === 0 ? '' : undefined}
              data-hero-slide={index}
              data-active={index === 0 ? 'true' : 'false'}
            />
          ))
        }
      </figure>

      {
        /* The cream scrim: a left-to-right fade over the photograph that keeps the overlaid copy
          legible without hiding the furniture on the right. Purely decorative. */
      }
      <div class="ngf-hero-scrim" aria-hidden="true"></div>

      {
        /*
      The slider indicators: understated horizontal bars at the bottom-right of the hero, the active
      one longer and darker. Real `<button>`s in a labelled group, so they are keyboard operable and
      announced; `aria-current` marks the active slide. Only rendered when there is more than one
      slide. The carousel behaviour (autoplay, click, keyboard, reduced motion) is wired by the
      script below; with no JavaScript these still show slide 1, which is correct.
    */
      }
      {
        isCarousel && (
          <div class="ngf-hero-dots" role="group" aria-label="Choose a showroom image">
            {heroSlides.map((slide, index) => (
              <button
                type="button"
                class="ngf-hero-dot"
                data-hero-dot={index}
                data-active={index === 0 ? 'true' : 'false'}
                aria-current={index === 0 ? 'true' : undefined}
                aria-label={`Show image ${index + 1} of ${heroSlides.length}: ${slide.alt}`}
              />
            ))}
          </div>
        )
      }
    </div>

    {
      /* Plane 2 — the copy, overlaid on the left over the scrim. Never moves under reduced motion. */
    }
    <div class="ngf-hero-plane ngf-hero-copy" data-parallax-plane="2" style="--plane-depth: 0.35;">
      <div class="ngf-hero-copy-inner" data-reveal data-motion-group>
        <p class="ngf-hero-eyebrow">
          {section.eyebrow !== undefined && <span class="ngf-hero-kicker">{section.eyebrow}</span>}
        </p>

        {
          /*
          The positioning line, revealed line by line with a `clip-path` wipe (Requirement 21.6),
          and unclipped on first paint under reduced motion (Requirement 7.11). The lines are the
          operator's own breaks.
        */
          headingLines.length > 0 ? (
            <TextReveal
              as="h1"
              id="ngf-hero-heading"
              class="ngf-hero-heading"
              lines={headingLines}
            />
          ) : (
            <h1 id="ngf-hero-heading" class="ngf-hero-heading">
              {settings.businessName}
            </h1>
          )
        }

        {section.subheading !== undefined && <p class="ngf-hero-sub">{section.subheading}</p>}

        {
          /*
          One prominent primary CTA (Explore the collection) and one elegant secondary (Custom
          furniture). Two, and a third is impossible rather than discouraged: the row takes no
          props. Each is ≥ 48 px through `.ngf-hero-cta` (Requirements 7.3, 24.3).
        */
        }
        <div class="ngf-hero-ctas">
          <a class="ngf-hero-cta ngf-hero-cta-primary" href={ctaHref}>
            {ctaLabel}
            <svg
              class="ngf-hero-cta-arrow"
              viewBox="0 0 20 12"
              width="18"
              height="11"
              aria-hidden="true"
              focusable="false"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M1 6h17M13 1l5 5-5 5"></path>
            </svg>
          </a>
          <a class="ngf-hero-cta ngf-hero-cta-secondary" href="/custom-furniture">
            Custom furniture
          </a>
        </div>

        {
          /*
          The assurances, as an inline row of small hairline icons with a two-line label each
          (sizes · delivery · workshop), matching the reference. Each glyph is decorative — the
          label carries the meaning — so every `<svg>` is `aria-hidden`. The icons are drawn inline
          rather than loaded, so the row adds no request.
        */
          assurances.length > 0 && (
            <ul class="ngf-hero-assurances">
              {assurances.map((item) => (
                <li>
                  <span class="ngf-hero-assurance-icon" aria-hidden="true">
                    {item.icon === 'ruler' && (
                      <svg
                        viewBox="0 0 24 24"
                        width="20"
                        height="20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        focusable="false"
                      >
                        <path d="M3 8.5 8.5 3 21 15.5 15.5 21z" />
                        <path d="M7 8.5 8.75 10.25M10 5.5 11.75 7.25M13 8.5 14.75 10.25M16 5.5 17.75 7.25" />
                      </svg>
                    )}
                    {item.icon === 'truck' && (
                      <svg
                        viewBox="0 0 24 24"
                        width="20"
                        height="20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        focusable="false"
                      >
                        <path d="M2 5h11v11H2zM13 8h4l3 3v5h-7z" />
                        <circle cx="6.5" cy="18" r="1.75" />
                        <circle cx="16.5" cy="18" r="1.75" />
                      </svg>
                    )}
                    {item.icon === 'hammer' && (
                      <svg
                        viewBox="0 0 24 24"
                        width="20"
                        height="20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        focusable="false"
                      >
                        <path d="M14.5 5.5 18 9l-3 3-3.5-3.5zM11.5 8.5 4 16v4h4l7.5-7.5" />
                      </svg>
                    )}
                  </span>
                  <span class="ngf-hero-assurance-label">{item.label}</span>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </div>
</section>

<script>
  /**
   * The hero crossfade carousel.
   *
   * A processed (bundled, hashed) module script — never `is:inline` — so it satisfies the
   * deployment's `script-src 'self'` policy the same way the header's script does. It self-guards on
   * `[data-ngf-carousel="true"]`, so it is a no-op on every page that has no carousel and on a hero
   * with a single slide.
   *
   * It autoplays through the slides on a slow premium interval, crossfading by opacity only (the CSS
   * does the fade) so the panel and the copy never move. The indicators are clickable,
   * arrow keys step when the panel is focused, and any deliberate interaction pauses autoplay for the
   * rest of the visit so it never fights the visitor. A resting pointer and a hidden tab pause it
   * too. Under reduced motion (or with the motion toggle off) autoplay does not start and the CSS
   * drops the crossfade, so slides switch instantly. Everything degrades to a static slide 1 with no
   * JavaScript.
   */
  const INTERVAL = 6000;
  for (const root of document.querySelectorAll<HTMLElement>('[data-ngf-carousel="true"]')) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-hero-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-hero-dot]'));
    if (slides.length < 2 || dots.length !== slides.length) continue;

    let current = 0;
    let timer = 0;
    let paused = false;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const motionOff = (): boolean =>
      reduce.matches || document.documentElement.getAttribute('data-motion') === 'off';

    const show = (next: number): void => {
      const target = (next + slides.length) % slides.length;
      if (target === current) return;
      slides[current]?.setAttribute('data-active', 'false');
      dots[current]?.setAttribute('data-active', 'false');
      dots[current]?.removeAttribute('aria-current');
      current = target;
      slides[current]?.setAttribute('data-active', 'true');
      dots[current]?.setAttribute('data-active', 'true');
      dots[current]?.setAttribute('aria-current', 'true');
    };

    const stop = (): void => {
      if (timer !== 0) {
        window.clearInterval(timer);
        timer = 0;
      }
    };
    const start = (): void => {
      if (paused || timer !== 0 || motionOff()) return;
      timer = window.setInterval(() => show(current + 1), INTERVAL);
    };
    const pauseForVisit = (): void => {
      paused = true;
      stop();
    };

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        pauseForVisit();
        show(index);
      });
    });

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        pauseForVisit();
        show(current + 1);
        event.preventDefault();
      } else if (event.key === 'ArrowLeft') {
        pauseForVisit();
        show(current - 1);
        event.preventDefault();
      }
    });

    // Pause while a pointer rests on the hero; resume on leave unless a deliberate interaction has
    // paused it for the visit.
    root.addEventListener('pointerenter', stop);
    root.addEventListener('pointerleave', start);

    // Pause while the tab is hidden, so nothing advances off-screen.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    start();
  }
</script>

<style>
  /*
   * The hero is one full-bleed showroom photograph with the copy overlaid on the left.
   *
   * It runs edge to edge across the viewport and up under the floating header, so the header sits
   * transparent over the image at the top of the page (the page passes `heroHeader`, which puts the
   * header in its `overHero` state). To reach up under the header the section pulls itself up by the
   * header's rendered height with a negative top margin, and restores that height as internal top
   * padding so the copy still clears the bar. It is the section's own ground, so there is no card,
   * no rounded panel, and no letterbox — the photograph is the background of the whole block.
   */
  .ngf-hero {
    position: relative;
    /* The header's rendered height, reserved so the copy clears the floating bar. Fluid because the
       header itself is a little taller from the desktop breakpoint up. */
    --ngf-hero-header-offset: 4.5rem;
    margin-top: calc(-1 * var(--ngf-hero-header-offset));
    isolation: isolate;
  }

  @media (min-width: 1024px) {
    .ngf-hero {
      --ngf-hero-header-offset: 5.5rem;
    }
  }

  /*
   * The layout.
   *
   * The image panel and the copy are stacked in the same grid cell — the photograph is the
   * background plane, the copy the foreground plane — so the copy sits over the image rather than
   * beside it. The inner element is the full-bleed box; its own padding is the page gutter plus the
   * reserved header height at the top, and it holds the copy to the content measure on the left.
   */
  .ngf-hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas: 'stack';
    min-height: clamp(30rem, 82vh, 46rem);
    padding: calc(var(--ngf-hero-header-offset) + clamp(1.5rem, 4vh, 3rem)) 1.25rem
      clamp(2rem, 6vh, 4rem);
  }

  /* The copy is a grid item; the image panel is taken out of flow and pinned to the whole section
     below, so only the copy participates in this grid. */
  .ngf-hero-inner > .ngf-hero-copy {
    grid-area: stack;
  }

  @media (min-width: 1024px) {
    .ngf-hero-inner {
      /* Hold the copy to the content measure and centre the whole block, while the image below still
         fills the viewport edge to edge. The extra left/right is the page's own gutter. */
      padding-inline: max(2rem, calc((100vw - var(--container-content)) / 2 + 2rem));
      min-height: clamp(34rem, 86vh, 52rem);
    }
  }

  /*
   * The photograph — the full-bleed background of the hero. It is absolutely positioned to fill the
   * whole section edge to edge (and up under the header), behind the scrim and the copy. `aspect-
   * ratio` is kept on the figure so the image-loading audit still counts it as a box-reserving
   * element and so the reserved box exists before the photograph decodes; `inset: 0` then stretches
   * it to the section's real height. No rounded corners and no shadow — it is the ground, not a card.
   */
  .ngf-hero-panel {
    position: absolute;
    inset: 0;
    z-index: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-cream);
  }

  /*
   * The planes.
   *
   * `will-change` is deliberately absent: the parallax loop applies it when it starts and removes it
   * when it stops (`frame-loop.ts`), so a layer is promoted only while it is being written to. Only
   * `transform` and `opacity` are transitioned (Requirement 21.8).
   */
  .ngf-hero-plane {
    transform: translate3d(0, 0, 0);
    transition:
      transform var(--dur-reveal) var(--ease-entrance),
      opacity var(--dur-reveal) var(--ease-entrance);
  }

  /* Requirement 7.11: planes hold their neutral position for the whole visit. */
  @media (prefers-reduced-motion: reduce) {
    .ngf-hero-plane {
      transform: none;
      transition: none;
    }
  }

  :global([data-motion='off']) .ngf-hero-plane {
    transform: none;
    transition: none;
  }

  /* ------------------------------------------------------------------ *
   * The photograph — the panel's ground
   * ------------------------------------------------------------------ */

  /*
   * The photograph fills the figure absolutely; `object-fit: cover` so the furniture fills the frame
   * without distortion. `object-position` is pushed toward the right so the photograph's open,
   * bright left third sits under the copy and its scrim, and the furniture reads in the centre/right
   * where the overlay is clear. The LQIP paints the same box until the photograph decodes
   * (Requirement 7.12).
   */
  .ngf-hero-figure {
    position: absolute;
    inset: 0;
    z-index: 0;
    margin: 0;
    overflow: hidden;
    background-color: var(--color-cream);
    background-position: center;
    background-size: cover;
  }

  /*
   * Every slide is absolutely stacked in the same box, so they occupy the identical area and the
   * hero never reflows between them (no layout shift). Only the active slide is opaque; the rest are
   * transparent. `object-fit: cover` fills the frame; `object-position` toward the RIGHT keeps the
   * furniture in view while the photograph's brighter left sits under the copy. A single,
   * non-carousel hero has one slide, which is simply always active.
   */
  .ngf-hero-slide {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
    opacity: 0;
    /* Crossfade by opacity only — transform/opacity are the only animated properties (21.8). */
    transition: opacity var(--dur-normal) var(--ease-standard);
  }

  .ngf-hero-slide[data-active='true'] {
    opacity: 1;
  }

  /* Reduced motion / motion off: no crossfade, slides switch instantly (Requirement 7.11, 21.11). */
  @media (prefers-reduced-motion: reduce) {
    .ngf-hero-slide {
      transition: none;
    }
  }

  :global([data-motion='off']) .ngf-hero-slide {
    transition: none;
  }

  @media (min-width: 768px) {
    .ngf-hero-slide {
      object-position: 65% center;
    }
  }

  @media (min-width: 1280px) {
    .ngf-hero-slide {
      object-position: center;
    }
  }

  /*
   * The composition fallback is a hairline drawing on cream, not a photograph — it must not be
   * cropped to the panel. So it is contained and centred on its cream ground.
   * (It is never carouselled, so it is always the single active slide.)
   */
  .ngf-hero[data-hero-mode='composition'] .ngf-hero-slide {
    object-fit: contain;
    object-position: center;
    padding: clamp(1.5rem, 5vw, 3.5rem);
  }

  /* ------------------------------------------------------------------ *
   * The scrim and the overlaid copy
   * ------------------------------------------------------------------ */

  /*
   * The scrim. The visible cream-to-transparent "fade" wash has been removed — the copy sits
   * directly over the photograph's naturally bright left area, matching the reference, so there is
   * no gradient veil over the image on desktop. On small screens the copy overlaps busier parts of
   * the photograph, so a very faint, even ivory veil is kept there purely for text legibility; it is
