---
/**
 * The homepage hero — one large showroom photograph with a soft left-to-right white fade, the copy
 * sitting over the faded left space. It reads as a single continuous photograph, not a split.
 *
 * Everything Requirements 7.3, 7.4, 7.5, 7.6, 7.11, and 7.12 pin down, and why each is structured
 * the way it is:
 *
 * - **The positioning line is the `<h1>`, and the brand mark is not.** The operator's line is the
 *   page's subject; the wordmark is a small eyebrow sibling so a visitor arriving from a search
 *   result sees who they have landed on, without the logotype pretending to be the heading.
 * - **Exactly two CTAs** — a loud primary (Explore the collection) and a quiet secondary (Custom
 *   furniture). WhatsApp and Call stay one tap away everywhere else (the header enquiry control, the
 *   WhatsApp band below, the sticky mobile action bar), so the hero stays uncluttered.
 * - **Exactly one image, and it is the largest painted element.** One `<img>` filling the panel as
 *   its ground, with its intrinsic width and height emitted so the box is reserved before a byte
 *   arrives (7.4, 15.10). The panel's `aspect-ratio` reserves the box and the LQIP fills it until
 *   the photograph decodes, so nothing shifts (7.12). Everything overlaid on it is type, a hairline
 *   rule, or a soft fade — nothing paints larger at any width from 320 px to 1920 px.
 * - **No video. Anywhere** (7.5).
 * - **Two parallax planes, transform and opacity only** (7.6, 21.8).
 * - **Reduced motion renders the final drawn state on first paint** (7.11).
 *
 * **The soft fade, not a panel.** A left-anchored warm-white gradient is painted over the
 * photograph so the copy stays legible; it fades smoothly to fully transparent before the centre,
 * so the furniture on the right is untouched and there is no rectangular overlay and no hard edge.
 * The photograph is positioned toward its right so the open hallway/floor on its left sits under the
 * copy — the headline never lands on the sofa.
 *
 * **The assurance row states nothing the operator has not supplied.** "Custom sizes and finishes"
 * and "Direct from the workshop" are the operator's own homepage sections restated as a line; the
 * delivery line is `settings.serviceArea` verbatim, and it renders only when that array is
 * non-empty. There is no lead time, no price, no capacity, and no history here (7.10).
 *
 * **On the image asset.** The hero paints the operator-supplied showroom photograph
 * (`settings.heroImage` → `/brand/hero.png`) as its dominant visual. When one is *not* supplied the
 * page passes a real product photograph as `showcase`, and failing that this falls back to the
 * project's own hairline room composition. Whichever it is, the homepage preloads the exact
 * resolution the hero paints (22.10).
 *
 * Requirements: 7.3, 7.4, 7.5, 7.6, 7.8, 7.10, 7.11, 7.12, 15.10, 15.11, 24.3.
 */
import TextReveal from '@/components/motion/TextReveal.astro';
import { getSiteSettings } from '@/lib/content/site';
import { loadingAttributes } from '@/lib/images/staging';
import { heroImageOf } from '@/lib/site/hero-image';
import type { HomepageSection } from '@/schemas/homepage';

interface HeroShowcaseImage {
  src: string;
  width: number;
  height: number;
  alt: string;
  lqip?: string;
  srcset: string;
  sizes: string;
}

interface HeroSlide {
  src: string;
  width: number;
  height: number;
  alt: string;
  lqip?: string;
  srcset?: string;
  sizes?: string;
}

interface Props {
  section: HomepageSection;
  /** The positioning line in force — `effectiveTagline(settings, homepage)`. */
  tagline: string | null;
  /**
   * A real product photograph to carry the hero when no `settings.heroImage` is supplied, resolved
   * by the page from the published catalogue. `null` when the operator has supplied a hero
   * photograph (which wins) or when the catalogue has none (the composition answers instead).
   */
  showcase?: HeroShowcaseImage | null;
  /**
   * The carousel's slides, built by the page: slide 1 is the prepared opening frame (the supplied
   * `hero.png`, else the showcase, else the composition), followed by real published product
   * photographs. Absent or single-entry → the hero is the static single image it always was.
   */
  slides?: HeroSlide[];
}

const { section, tagline, showcase = null, slides } = Astro.props;
const settings = getSiteSettings();

/*
 * The hero image. The operator's supplied showroom photograph wins; otherwise the page's product
 * showcase; otherwise the designed composition. `heroImageOf` answers the first and third, and the
 * page decides whether to pass a `showcase` (it passes `null` whenever a hero image is supplied).
 */
const supplied = heroImageOf(settings);
const image = supplied.supplied ? supplied : (showcase ?? supplied);
/*
 * "Photo" means the panel paints a real photograph edge to edge (cover) with the fade over it;
 * "composition" means the hairline fallback drawing, which is contained on cream with no fade. The
 * supplied hero photo and a product showcase are both photos; only the `HERO_COMPOSITION` fallback
 * (never supplied, never a showcase) is a composition.
 */
const isPhoto = supplied.supplied || showcase !== null;

/*
 * The slides to paint. When the page supplied a list, use it; otherwise fall back to the single
 * `image` the hero resolved, so the component still renders standalone. The composition fallback is
 * never carouselled — a hairline drawing is not a product photograph — so it stays a single slide.
 */
const firstFallback: HeroSlide = {
  src: image.src,
  width: image.width,
  height: image.height,
  alt: image.alt,
  ...(image.lqip === undefined ? {} : { lqip: image.lqip }),
  ...(showcase !== null ? { srcset: showcase.srcset, sizes: showcase.sizes } : {}),
};
const heroSlides: HeroSlide[] =
  isPhoto && slides !== undefined && slides.length > 0 ? slides : [firstFallback];
const isCarousel = heroSlides.length > 1;
const loading = loadingAttributes({ priority: true });

const ctaLabel = section.ctaLabel ?? 'Explore the collection';
const ctaHref = section.ctaHref ?? '/collection';

/**
 * The three assurances. Each one restates something already supplied — two of the operator's own
 * homepage sections and `settings.serviceArea` — so the row adds emphasis, never a new claim.
 */
const assurances = [
  'Custom sizes and finishes',
  'Direct from the workshop',
  ...(settings.serviceArea.length > 0
    ? [`Delivered across ${settings.serviceArea.join(', ')}`]
    : []),
];

/** The heading's lines are the operator's own line breaks, exactly as `TextReveal` requires. */
const headingLines =
  tagline === null
    ? []
    : tagline
        .split('\n')
        .map((line) => line.trim())
        .filter((line) => line !== '');
---

<section
  class="ngf-hero"
  aria-labelledby="ngf-hero-heading"
  data-ngf-section="hero"
  data-hero-mode={isPhoto ? 'photo' : 'composition'}
  data-parallax-root
>
  {
    /*
    One large rounded showroom panel. The photograph fills it as the ground; a soft left-to-right
    white fade lays over it so the copy on the left stays legible; the copy overlays both. It reads
    as a single continuous photograph — no split, no boxed panel, no hard edge.
  */
  }
  <div
    class="ngf-hero-panel"
    data-ngf-carousel={isCarousel ? 'true' : undefined}
    data-hero-count={heroSlides.length}
  >
    {
      /*
      Plane 1 — the image, filling the panel as its ground. When there is more than one slide the
      figure holds them stacked, each absolutely filling the same box, crossfaded by opacity only —
      so every slide occupies the identical area and nothing reflows between them (no layout shift).
      Slide 0 is the prepared opening frame: visible on first paint, eager and high-priority, and it
      is the image the page preloads. The rest are lazy and start transparent, decoded off the
      critical path, so a long collection never hurts LCP.

      The `.ngf-hero-figure` class and the intrinsic width/height on each `<img>` keep the box
      reserved for the image-loading audit and for CLS.
    */
    }
    <figure
      class="ngf-hero-figure ngf-hero-plane"
      data-parallax-plane="1"
      style={`--plane-depth: 0.15;${
        heroSlides[0]?.lqip === undefined ? '' : `background-image:url(${heroSlides[0].lqip});`
      }`}
      data-has-lqip={heroSlides[0]?.lqip === undefined ? 'false' : 'true'}
      aria-hidden={isPhoto ? undefined : 'true'}
    >
      {
        heroSlides.map((slide, index) => (
          <img
            class="ngf-hero-slide"
            src={slide.src}
            srcset={slide.srcset}
            sizes={slide.sizes}
            width={slide.width}
            height={slide.height}
            alt={slide.alt}
            loading={index === 0 ? loading.loading : 'lazy'}
            fetchpriority={index === 0 ? loading.fetchpriority : 'auto'}
            decoding={index === 0 ? loading.decoding : 'async'}
            data-ngf-hero-image={index === 0 ? '' : undefined}
            data-hero-slide={index}
            data-active={index === 0 ? 'true' : 'false'}
          />
        ))
      }
    </figure>

    {
      /*
      The soft left fade. A left-anchored warm-white gradient that starts near-opaque at the extreme
      left — where the copy sits, over the photograph's open hallway/floor — and eases to fully
      transparent before the centre, so the furniture on the right is completely untouched. Many
      closely-spaced stops make the transition smooth with no visible boundary. Only over a photo;
      the composition fallback keeps dark type on its cream ground with no fade.
    */
    }
    {isPhoto && <div class="ngf-hero-fade" aria-hidden="true" />}

    {/* Plane 2 — the copy, overlaid on the faded left space. Never moves under reduced motion. */}
    <div class="ngf-hero-plane ngf-hero-copy" data-parallax-plane="2" style="--plane-depth: 0.35;">
      <div class="ngf-hero-copy-inner" data-reveal data-motion-group>
        <p class="ngf-hero-eyebrow">
          {section.eyebrow !== undefined && <span class="ngf-hero-kicker">{section.eyebrow}</span>}
        </p>

        {
          /*
          The positioning line, revealed line by line with a `clip-path` wipe (Requirement 21.6),
          and unclipped on first paint under reduced motion (Requirement 7.11). The lines are the
          operator's own breaks.
        */
          headingLines.length > 0 ? (
            <TextReveal
              as="h1"
              id="ngf-hero-heading"
              class="ngf-hero-heading"
              lines={headingLines}
            />
          ) : (
            <h1 id="ngf-hero-heading" class="ngf-hero-heading">
              {settings.businessName}
            </h1>
          )
        }

        {section.subheading !== undefined && <p class="ngf-hero-sub">{section.subheading}</p>}

        {
          /*
          One prominent primary CTA (Explore the collection) and one elegant secondary (Custom
          furniture). Two, and a third is impossible rather than discouraged: the row takes no
          props. Each is ≥ 48 px through `.ngf-hero-cta` (Requirements 7.3, 24.3).
        */
        }
        <div class="ngf-hero-ctas">
          <a class="ngf-hero-cta ngf-hero-cta-primary" href={ctaHref}>
            {ctaLabel}
            <svg
              class="ngf-hero-cta-arrow"
              viewBox="0 0 20 12"
              width="18"
              height="11"
              aria-hidden="true"
              focusable="false"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M1 6h17M13 1l5 5-5 5"></path>
            </svg>
          </a>
          <a class="ngf-hero-cta ngf-hero-cta-secondary" href="/custom-furniture">
            Custom furniture
          </a>
        </div>

        {
          assurances.length > 0 && (
            <ul class="ngf-hero-assurances">
              {assurances.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    {
      /*
      The slider indicators: understated horizontal bars at the bottom-centre of the panel, the
      active one longer and brighter. Real `<button>`s in a labelled group, so they are keyboard
      operable and announced; `aria-current` marks the active slide. Only rendered when there is
      more than one slide. The carousel behaviour (autoplay, click, keyboard, reduced motion) is
      wired by the script below; with no JavaScript these still show slide 1, which is correct.
    */
    }
    {
      isCarousel && (
        <div class="ngf-hero-dots" role="group" aria-label="Choose a showroom image">
          {heroSlides.map((slide, index) => (
            <button
              type="button"
              class="ngf-hero-dot"
              data-hero-dot={index}
              data-active={index === 0 ? 'true' : 'false'}
              aria-current={index === 0 ? 'true' : undefined}
              aria-label={`Show image ${index + 1} of ${heroSlides.length}: ${slide.alt}`}
            />
          ))}
        </div>
      )
    }
  </div>
</section>

<script>
  /**
   * The hero crossfade carousel.
   *
   * A processed (bundled, hashed) module script — never `is:inline` — so it satisfies the
   * deployment's `script-src 'self'` policy the same way the header's script does. It self-guards on
   * `[data-ngf-carousel="true"]`, so it is a no-op on every page that has no carousel and on a hero
   * with a single slide.
   *
   * It autoplays through the slides on a slow premium interval, crossfading by opacity only (the CSS
   * does the fade) so the panel, the fade and the copy never move. The indicators are clickable,
   * arrow keys step when the panel is focused, and any deliberate interaction pauses autoplay for the
   * rest of the visit so it never fights the visitor. A resting pointer and a hidden tab pause it
   * too. Under reduced motion (or with the motion toggle off) autoplay does not start and the CSS
   * drops the crossfade, so slides switch instantly. Everything degrades to a static slide 1 with no
   * JavaScript.
   */
  const INTERVAL = 6000;
  for (const root of document.querySelectorAll<HTMLElement>('[data-ngf-carousel="true"]')) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-hero-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-hero-dot]'));
    if (slides.length < 2 || dots.length !== slides.length) continue;

    let current = 0;
    let timer = 0;
    let paused = false;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const motionOff = (): boolean =>
      reduce.matches || document.documentElement.getAttribute('data-motion') === 'off';

    const show = (next: number): void => {
      const target = (next + slides.length) % slides.length;
      if (target === current) return;
      slides[current]?.setAttribute('data-active', 'false');
      dots[current]?.setAttribute('data-active', 'false');
      dots[current]?.removeAttribute('aria-current');
      current = target;
      slides[current]?.setAttribute('data-active', 'true');
      dots[current]?.setAttribute('data-active', 'true');
      dots[current]?.setAttribute('aria-current', 'true');
    };

    const stop = (): void => {
      if (timer !== 0) {
        window.clearInterval(timer);
        timer = 0;
      }
    };
    const start = (): void => {
      if (paused || timer !== 0 || motionOff()) return;
      timer = window.setInterval(() => show(current + 1), INTERVAL);
    };
    const pauseForVisit = (): void => {
      paused = true;
      stop();
    };

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        pauseForVisit();
        show(index);
      });
    });

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        pauseForVisit();
        show(current + 1);
        event.preventDefault();
      } else if (event.key === 'ArrowLeft') {
        pauseForVisit();
        show(current - 1);
        event.preventDefault();
      }
    });

    // Pause while a pointer rests on the hero; resume on leave unless a deliberate interaction has
    // paused it for the visit.
    root.addEventListener('pointerenter', stop);
    root.addEventListener('pointerleave', start);

    // Pause while the tab is hidden, so nothing advances off-screen.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    start();
  }
</script>

<style>
  /*
   * The hero is one large photograph. The outer element is just the page gutter and the vertical
   * rhythm; the panel inside it holds the photograph, the fade, and the copy.
   */
  .ngf-hero {
    position: relative;
    max-width: var(--container-content);
    margin-inline: auto;
    /* A small deliberate gap under the floating header, then generous air before the next band. */
    padding: clamp(1rem, 2.5vh, 2rem) 1.25rem clamp(2rem, 5vh, 3.5rem);
    isolation: isolate;
  }

  @media (min-width: 1024px) {
    .ngf-hero {
      padding-inline: 2rem;
    }
  }

  /*
   * The one large rounded showroom panel: the photograph fills it, the fade and copy overlay it.
   *
   * The box is reserved by `aspect-ratio`, not a fixed height, so the panel holds its height from
   * its width before the photograph loads and there is no shift (Requirement 7.12). A portrait-ish
   * ratio on a phone reads well; a wide cinematic ratio on desktop lets the whole living-room scene
   * read at once. `min-height`/`max-height` keep it substantial but never enormous.
   */
  .ngf-hero-panel {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    min-height: 28rem;
    max-height: 34rem;
    overflow: hidden;
    border-radius: var(--radius-xl);
    /* Ivory ground matches the fade, so the faded region and the frame read as one warm surface. */
    background-color: var(--color-ivory);
    box-shadow: var(--shadow-lift);
  }

  @media (min-width: 768px) {
    .ngf-hero-panel {
      aspect-ratio: 3 / 2;
      min-height: 30rem;
      max-height: 40rem;
    }
  }

  @media (min-width: 1024px) {
    .ngf-hero-panel {
      /* Close to the supplied photograph's own 1470×827 (~16:9) crop, so it fills the panel with
         no letterbox, and tall enough to dominate the first viewport. */
      aspect-ratio: 16 / 8;
      min-height: 32rem;
      max-height: 42rem;
    }
  }

  @media (min-width: 1440px) {
    .ngf-hero-panel {
      aspect-ratio: 16 / 7.5;
      max-height: 46rem;
    }
  }

  /*
   * The planes.
   *
   * `will-change` is deliberately absent: the parallax loop applies it when it starts and removes it
   * when it stops (`frame-loop.ts`), so a layer is promoted only while it is being written to. Only
   * `transform` and `opacity` are transitioned (Requirement 21.8).
   */
  .ngf-hero-plane {
    transform: translate3d(0, 0, 0);
    transition:
      transform var(--dur-reveal) var(--ease-entrance),
      opacity var(--dur-reveal) var(--ease-entrance);
  }

  /* Requirement 7.11: planes hold their neutral position for the whole visit. */
  @media (prefers-reduced-motion: reduce) {
    .ngf-hero-plane {
      transform: none;
      transition: none;
    }
  }

  :global([data-motion='off']) .ngf-hero-plane {
    transform: none;
    transition: none;
  }

  /* ------------------------------------------------------------------ *
   * The photograph — the panel's ground
   * ------------------------------------------------------------------ */

  /*
   * The photograph fills the panel absolutely; `object-fit: cover` so the furniture fills the frame
   * without distortion. `object-position` is pushed toward the right so the photograph's open
   * hallway/floor on its left sits under the copy and the sofa moves toward the centre/right — which
   * is what reserves the readable left space without cropping the furniture away. Scaled a touch
   * beyond the frame so the parallax drift never reveals an edge. The LQIP paints the same box until
   * the photograph decodes (Requirement 7.12).
   */
  .ngf-hero-figure {
    position: absolute;
    inset: 0;
    z-index: 0;
    margin: 0;
    overflow: hidden;
    background-color: var(--color-cream);
    background-position: center;
    background-size: cover;
  }

  /*
   * Every slide is absolutely stacked in the same box, so they occupy the identical area and the
   * panel never reflows between them (no layout shift). Only the active slide is opaque; the rest
   * are transparent. `object-fit: cover` fills the frame; `object-position` toward the LEFT keeps
   * the photograph's open, bright hallway/floor — its left ~third — in frame, exactly where the copy
   * sits, so the furniture reads in the centre/right. A single, non-carousel hero has one slide,
   * which is simply always active.
   */
  .ngf-hero-slide {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    /* Crossfade by opacity only — transform/opacity are the only animated properties (21.8). */
    transition: opacity var(--dur-normal) var(--ease-standard);
  }

  .ngf-hero-slide[data-active='true'] {
    opacity: 1;
  }

  /* Reduced motion / motion off: no crossfade, slides switch instantly (Requirement 7.11, 21.11). */
  @media (prefers-reduced-motion: reduce) {
    .ngf-hero-slide {
      transition: none;
    }
  }

  :global([data-motion='off']) .ngf-hero-slide {
    transition: none;
  }

  @media (min-width: 768px) {
    .ngf-hero-slide {
      object-position: 22% center;
    }
  }

  @media (min-width: 1280px) {
    .ngf-hero-slide {
      object-position: 14% center;
    }
  }

  /*
   * The composition fallback is a hairline drawing on cream, not a photograph — it must not be
   * cropped to the panel. So it is contained and centred on its cream ground, with no fade over it.
   * (It is never carouselled, so it is always the single active slide.)
   */
  .ngf-hero[data-hero-mode='composition'] .ngf-hero-slide {
    object-fit: contain;
    object-position: center;
    padding: clamp(1.5rem, 5vw, 3.5rem);
  }

  /* ------------------------------------------------------------------ *
   * The soft left fade
   * ------------------------------------------------------------------ */

  /*
   * A left-anchored warm-white wash over the photograph. Near-opaque at the extreme left where the
   * copy sits, easing to fully transparent before the centre so the furniture on the right is
   * untouched. The stops are many and closely spaced so there is no visible boundary — it looks like
   * the photograph itself brightens toward the left, not like a panel laid on top. Warm white
   * (`--color-ivory`, 250 248 244) keeps the hero light and airy; charcoal copy sits on top.
   */
  .ngf-hero-fade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    /*
     * Two layers, so the transition never reads as one straight vertical seam:
     *
     * 1. The primary left→right ivory wash. Solid ivory holds across the left where the copy sits,
     *    then eases through many closely-spaced stops to fully transparent past the centre. The long,
     *    gentle ramp is what makes it look like the photograph itself brightening into the ground,
     *    not a panel with an edge.
     * 2. A faint radial lift centred on the lower-left, feathering the wash so its right boundary is
     *    a soft curve rather than a vertical line — the tell that gives a flat CSS gradient away.
     *
     * The ivory (250 248 244) matches the panel's own ground, so the faded region and the frame read
     * as one continuous warm surface.
     */
    background:
      radial-gradient(
        120% 130% at 12% 78%,
        rgb(250 248 244 / 0.5) 0%,
        rgb(250 248 244 / 0.22) 34%,
        rgb(250 248 244 / 0) 60%
      ),
      linear-gradient(
        90deg,
        rgb(250 248 244 / 0.98) 0%,
        rgb(250 248 244 / 0.97) 20%,
        rgb(250 248 244 / 0.92) 32%,
        rgb(250 248 244 / 0.82) 42%,
        rgb(250 248 244 / 0.64) 52%,
        rgb(250 248 244 / 0.42) 62%,
        rgb(250 248 244 / 0.22) 72%,
        rgb(250 248 244 / 0.08) 82%,
        rgb(250 248 244 / 0) 92%
      );
  }

  /*
   * On a phone the copy is a full-width block anchored to the bottom, so the fade becomes a smooth
   * bottom-to-top warm-white wash instead of a left one — lighter where the copy sits, fading up
   * into the photograph, keeping the furniture visible above and every line of copy legible.
   */
  @media (max-width: 767px) {
    .ngf-hero-fade {
      background: linear-gradient(
        to top,
        rgb(250 248 244 / 0.96) 0%,
        rgb(250 248 244 / 0.9) 26%,
        rgb(250 248 244 / 0.66) 48%,
        rgb(250 248 244 / 0.32) 68%,
        rgb(250 248 244 / 0.1) 84%,
        rgb(250 248 244 / 0) 100%
      );
    }
  }

  /* ------------------------------------------------------------------ *
   * The copy, overlaid on the faded left space
   * ------------------------------------------------------------------ */

  .ngf-hero-copy {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    /* Phone: the copy sits in the lower warm wash. Wider viewports centre it on the left (below). */
    justify-content: flex-end;
    padding: clamp(1.5rem, 5vw, 4rem);
  }

  .ngf-hero-copy-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(0.9rem, 1.6vw, 1.35rem);
    max-width: 34rem;
  }

  /*
   * From the tablet breakpoint up the copy is anchored to the left and vertically centred, sitting
   * over the faded open space. Held to a comfortable measure so the headline breaks well and never
   * runs toward the furniture.
   */
  @media (min-width: 768px) {
    .ngf-hero[data-hero-mode='photo'] .ngf-hero-copy {
      justify-content: center;
