---
/**
 * Shop by category — the second homepage section.
 *
 * The nine categories come from `data/categories/*.json` through `getPublishedCategories()`, so a
 * new category file appears here with no code change, and an unpublished one disappears. The tiles
 * are type-led hairline panels rather than photographic ones because there are no category
 * photographs (Open Items item 5) and a grey box captioned "Sofas" is worse than a confident
 * typographic tile.
 *
 * The count under each name excludes drafts and unpublished products, because it is derived from
 * `getCatalogue()` — the count on this page and the count on `/collection/{slug}` are the same
 * number from the same source (Requirement 1.16).
 *
 * Requirements: 1.16, 7.1, 9.7.
 */
import SectionHeader from '@/components/home/SectionHeader.astro';
import ArrowMotion from '@/components/motion/ArrowMotion.astro';
import CategoryIllustration from '@/components/motion/CategoryIllustration.astro';
import type { CategoryIllustrationValue } from '@/schemas/category';
import type { HomepageSection } from '@/schemas/homepage';

export interface CategoryTile {
  slug: string;
  name: string;
  count: number;
  /** The schema's illustration key, which selects the tile's glyph. */
  illustration: CategoryIllustrationValue;
}

interface Props {
  section: HomepageSection;
  categories: readonly CategoryTile[];
}

const { section, categories } = Astro.props;
---

{
  categories.length > 0 && (
    <section
      class="ngf-home-section ngf-home-categories"
      aria-labelledby="ngf-categories-heading"
      data-ngf-section="shopByCategory"
      data-motion-section
      data-reveal
    >
      <SectionHeader
        eyebrow={section.eyebrow}
        heading={section.heading ?? 'Shop by category'}
        subheading={section.subheading}
        headingId="ngf-categories-heading"
      />
      {/*
        One reveal for the whole grid, not one per tile. `data-motion-group` on the `<ul>` means the
        nine tiles share a single parent animation and stagger from it — so the grid counts as one
        animating element against Requirement 21.9's ceiling of twelve rather than nine.
      */}
      <ul class="ngf-category-grid" data-reveal data-motion-group>
        {categories.map((category) => (
          <li>
            <a href={`/collection/${category.slug}`} class="ngf-category-tile" data-motion-lift>
              <span class="ngf-category-glyph">
                {/*
                  `trigger="none"`: the glyph renders its final drawn state and the tile's own
                  reveal — inherited from the grid's single group animation — carries the motion.
                  Nine glyphs each drawing themselves would be nine simultaneously animating
                  elements, which is most of Requirement 21.9's budget spent on decoration.
                */}
                <CategoryIllustration
                  illustration={category.illustration}
                  strokeWidth={1}
                  trigger="none"
                />
              </span>
              <span class="ngf-category-foot">
                <span class="ngf-category-name">{category.name}</span>
                {/*
                  "Explore", not a count.

                  The count was honest and useless: with no products uploaded every one of the nine
                  tiles read "0 pieces", which tells a customer the shop is empty rather than inviting
                  them into it. The number is not what anyone is deciding on at this point in the
                  journey — the room is. Once products exist the tile still says Explore, because a
                  category with four pieces and one with forty are both simply worth opening.
                */}
                <span class="ngf-category-count">Explore</span>
              </span>
              <span class="ngf-category-arrow">
                <ArrowMotion size={16} />
              </span>
            </a>
          </li>
        ))}
      </ul>

      <p class="ngf-category-all">
        {/* The shared elegant underline reveal (motion.css `.ngf-underline`): drawn by default,
            so it degrades to a plain visible underline with no JS or under reduced motion, and it
            draws in from the left on hover/focus-visible — the same inline-link language site-wide. */}
        <a href="/collection" class="ngf-underline">
          See the whole collection
        </a>
      </p>
    </section>
  )
}

<style>
  /*
   * Nine separate cards rather than a hairline table.
   *
   * The grid used to be a 1 px taupe background showing through the gaps, which made the nine
   * categories read as one grey spreadsheet — and at three columns the third row's cell borders did
   * not line up with the two above it, so the last tile looked like a stray label. Individual cards
   * with their own border cannot produce that artefact at any column count.
   */
  .ngf-category-grid {
    display: grid;
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }

  @media (min-width: 480px) {
    .ngf-category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .ngf-category-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .ngf-category-grid > li {
    display: flex;
  }

  .ngf-category-tile {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.75rem;
    min-height: 200px;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    overflow: hidden;
    border: 1px solid var(--color-taupe);
    border-radius: var(--radius-lg);
    background-color: var(--color-white);
    color: var(--color-obsidian);
    text-decoration: none;
    transition:
      transform var(--dur-normal) var(--ease-standard),
      box-shadow var(--dur-normal) var(--ease-standard),
      border-color var(--dur-normal) var(--ease-standard);
  }

  @media (hover: hover) {
    .ngf-category-tile:hover {
      transform: translateY(-4px);
      border-color: var(--color-walnut);
      box-shadow: var(--shadow-lift);
    }
  }

  .ngf-category-tile:focus-visible {
    border-color: var(--color-obsidian);
  }

  @media (prefers-reduced-motion: reduce) {
    .ngf-category-tile {
      transition: none;
    }

    .ngf-category-tile:hover {
      transform: none;
    }
  }

  .ngf-category-foot {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: auto;
  }

  .ngf-category-name {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1.15;
  }

  .ngf-category-count {
    color: var(--color-walnut);
    font-size: var(--text-small);
  }

  /*
   * The one champagne element in this band (Requirement 21.2): a 16 px arrow stroke. Not a fill,
   * not body text, and the tile's name and count are both obsidian/walnut.
   */
  .ngf-category-arrow {
    position: absolute;
    top: clamp(1.25rem, 2.5vw, 1.75rem);
    right: clamp(1.25rem, 2.5vw, 1.75rem);
    display: inline-flex;
    color: var(--color-champagne);
    transition: transform var(--dur-normal) var(--ease-standard);
  }

  /*
   * The glyph is the tile's subject, so it is given room and enough contrast to be seen. It was
   * 72 px wide in taupe, which at card size read as a smudge.
   */
  .ngf-category-glyph {
    display: block;
    width: 100%;
    max-width: 132px;
    color: var(--color-taupe);
    transition:
      color var(--dur-normal) var(--ease-standard),
      transform var(--dur-normal) var(--ease-standard);
  }

  .ngf-category-glyph :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The glyph and the arrow move with the tile, so the hover reads as one movement. */
  @media (hover: hover) {
    .ngf-category-tile:hover .ngf-category-glyph,
    .ngf-category-tile:focus-visible .ngf-category-glyph {
      color: var(--color-sage);
      transform: scale(1.04);
    }

    /* Focus-visible nudges the arrow too, so a keyboard visitor gets the same acknowledgement. */
    .ngf-category-tile:hover .ngf-category-arrow,
    .ngf-category-tile:focus-visible .ngf-category-arrow {
      transform: translateX(3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ngf-category-glyph,
    .ngf-category-arrow {
      transition: none;
    }

    .ngf-category-tile:hover .ngf-category-glyph,
    .ngf-category-tile:hover .ngf-category-arrow {
      transform: none;
    }
  }

  .ngf-category-all {
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
  }

  /*
   * The underline itself is the shared `.ngf-underline` utility from motion.css (drawn by default,
   * elegant scaleX draw on hover/focus). This rule only carries the colour and the ≥ 44 px touch
   * target: vertical padding rather than a stretched `min-height`, so the utility's 1 px line hugs
   * the text baseline instead of sitting at the bottom of a tall flex box.
   */
  .ngf-category-all a {
    display: inline-block;
    padding-block: 0.6rem;
    color: var(--color-obsidian);
  }
</style>
