---
/**
 * Shop by category — the second homepage section, rebuilt to match the reference as a row of
 * photographic cards.
 *
 * The reference presents six rooms — Sofas & Sectionals, Beds, Dining Tables, Chairs, Shoe Stands
 * and Temples — each a photograph with a name, a one-line subtitle and a circular arrow, and each
 * the whole card being a link to that category's `/collection/{slug}` page. Those six categories
 * all exist as real `data/categories/*.json` files, so every card opens a genuine listing rather
 * than a dead end.
 *
 * The photographs are committed static WebP under `public/categories/{slug}/card-{480,768}.webp`,
 * so they resolve as plain same-origin files (the pattern the hero and the other page photos use)
 * and are cover-cropped into a fixed 4:3 frame that reserves its box against layout shift. They are
 * lazy and async — the homepage's one prioritised image is the hero above — so a six-photo row
 * never competes with the LCP.
 *
 * The presentational layer (which six tiles, in what order, each subtitle and photo) is declared
 * here rather than in the category data, because a subtitle like "Comfort for every moment" and a
 * chosen photograph are homepage art direction, not a fact about the category. Each tile is only
 * rendered when its slug is among the published categories passed in, so an unpublished category
 * silently drops out rather than linking somewhere that 404s.
 *
 * Requirements: 1.16, 7.1, 9.7.
 */
import SectionHeader from '@/components/home/SectionHeader.astro';
import type { CategoryIllustrationValue } from '@/schemas/category';
import type { HomepageSection } from '@/schemas/homepage';

export interface CategoryTile {
  slug: string;
  name: string;
  count: number;
  /** The schema's illustration key. Kept for prop compatibility; the photo cards do not use it. */
  illustration: CategoryIllustrationValue;
}

interface Props {
  section: HomepageSection;
  categories: readonly CategoryTile[];
}

const { section, categories } = Astro.props;

/**
 * The six reference tiles, in order. `slug` maps each to its real category page; `subtitle` and the
 * card photograph are the homepage's own art direction. `name` here matches the reference labels
 * exactly (e.g. "Sofas & Sectionals", "Chairs" for the dining-chairs category).
 */
const REFERENCE_TILES: readonly { slug: string; name: string; subtitle: string }[] = [
  { slug: 'sofas', name: 'Sofas & Sectionals', subtitle: 'Comfort for every moment' },
  { slug: 'beds', name: 'Beds', subtitle: 'Rest, redefined' },
  { slug: 'dining-tables', name: 'Dining Tables', subtitle: 'Bring people together' },
  { slug: 'dining-chairs', name: 'Chairs', subtitle: 'Style in every seat' },
  { slug: 'shoe-stands', name: 'Shoe Stands', subtitle: 'Organise in style' },
  { slug: 'temples', name: 'Temples', subtitle: 'For a more peaceful home' },
];

const published = new Set(categories.map((category) => category.slug));
const tiles = REFERENCE_TILES.filter((tile) => published.has(tile.slug)).map((tile) => ({
  ...tile,
  href: `/collection/${tile.slug}`,
  img480: `/categories/${tile.slug}/card-480.webp`,
  img768: `/categories/${tile.slug}/card-768.webp`,
}));
---

{
  tiles.length > 0 && (
    <section
      class="ngf-home-section ngf-home-categories"
      aria-labelledby="ngf-categories-heading"
      data-ngf-section="shopByCategory"
      data-motion-section
      data-reveal
    >
      <div class="ngf-category-head">
        <SectionHeader
          eyebrow={section.eyebrow ?? 'Find what fits you'}
          heading={section.heading ?? 'Shop by Category'}
          subheading={section.subheading}
          headingId="ngf-categories-heading"
        />
        <a class="ngf-category-viewall" href="/collection">
          View all products
          <svg
            viewBox="0 0 20 12"
            width="18"
            height="11"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M1 6h17M13 1l5 5-5 5" />
          </svg>
        </a>
      </div>

      <ul class="ngf-category-grid" data-reveal data-motion-group>
        {tiles.map((tile) => (
          <li>
            <a href={tile.href} class="ngf-category-tile" data-motion-lift>
              <span class="ngf-category-frame">
                <img
                  class="ngf-category-photo"
                  src={tile.img480}
                  srcset={`${tile.img480} 480w, ${tile.img768} 768w`}
                  sizes="(min-width: 1024px) 16vw, (min-width: 480px) 45vw, 90vw"
                  width={768}
                  height={512}
                  alt={tile.name}
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="ngf-category-foot">
                <span class="ngf-category-text">
                  <span class="ngf-category-name">{tile.name}</span>
                  <span class="ngf-category-sub">{tile.subtitle}</span>
                </span>
                <span class="ngf-category-arrow" aria-hidden="true">
                  <svg
                    viewBox="0 0 20 12"
                    width="16"
                    height="10"
                    focusable="false"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M1 6h17M13 1l5 5-5 5" />
                  </svg>
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  /*
   * The section head is a two-part row: the eyebrow/heading block on the left, and a
   * "View all products" link aligned to the right on wide viewports (the reference). On a phone the
   * link drops below the heading.
   */
  .ngf-category-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .ngf-category-head > :global(.ngf-section-head) {
    margin-bottom: 0;
  }

  .ngf-category-viewall {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.4rem;
    color: var(--color-obsidian);
    font-size: var(--text-body);
    text-decoration: none;
    white-space: nowrap;
    transition: gap var(--dur-fast) var(--ease-standard);
  }

  .ngf-category-viewall svg {
    flex: none;
    transition: transform var(--dur-fast) var(--ease-standard);
  }

  @media (hover: hover) {
    .ngf-category-viewall:hover svg,
    .ngf-category-viewall:focus-visible svg {
      transform: translateX(3px);
    }
  }

  /*
   * Six photo cards in a row on a wide viewport, matching the reference, collapsing to three, then
   * two on smaller screens. Each card is a rounded photograph over a name, subtitle and circular
   * arrow.
   */
  .ngf-category-grid {
    display: grid;
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 640px) {
    .ngf-category-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .ngf-category-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  .ngf-category-grid > li {
    display: flex;
  }

  .ngf-category-tile {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.85rem;
    padding: clamp(0.6rem, 1.2vw, 0.85rem);
    overflow: hidden;
    border: 1px solid var(--color-taupe);
    border-radius: var(--radius-lg);
    background-color: var(--color-white);
    color: var(--color-obsidian);
    text-decoration: none;
    box-shadow: var(--shadow-level1);
    transition:
      transform var(--dur-normal) var(--ease-standard),
      box-shadow var(--dur-normal) var(--ease-standard),
      border-color var(--dur-normal) var(--ease-standard);
  }

  /* The photo frame — a fixed 4:3 rounded window, cover-cropped, so every card is the same shape. */
  .ngf-category-frame {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--color-cream);
  }

  .ngf-category-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-normal) var(--ease-standard);
  }

  @media (hover: hover) {
    .ngf-category-tile:hover {
      transform: translateY(-4px);
      border-color: var(--color-walnut);
      box-shadow: var(--shadow-lift);
    }

    .ngf-category-tile:hover .ngf-category-photo,
    .ngf-category-tile:focus-visible .ngf-category-photo {
      transform: scale(1.05);
    }
  }

  .ngf-category-tile:focus-visible {
    border-color: var(--color-obsidian);
    outline: 2px solid var(--color-obsidian);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .ngf-category-tile,
    .ngf-category-photo {
      transition: none;
    }

    .ngf-category-tile:hover {
      transform: none;
    }

    .ngf-category-tile:hover .ngf-category-photo {
      transform: none;
    }
  }

  /* Name + subtitle on the left, a circular arrow on the right — the reference's card foot. */
  .ngf-category-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.15rem 0.35rem 0.4rem;
  }

  .ngf-category-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .ngf-category-name {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 400;
    line-height: 1.15;
  }

  .ngf-category-sub {
    color: var(--color-walnut);
    font-size: var(--text-small);
    line-height: 1.3;
  }

  /* The circular arrow, the reference's one warm accent per card. */
  .ngf-category-arrow {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid color-mix(in srgb, var(--color-champagne) 55%, var(--color-taupe));
    border-radius: var(--radius-pill);
    background-color: var(--color-cream);
    color: var(--color-obsidian);
    transition:
      background-color var(--dur-fast) var(--ease-standard),
      transform var(--dur-fast) var(--ease-standard);
  }

  @media (hover: hover) {
    .ngf-category-tile:hover .ngf-category-arrow,
    .ngf-category-tile:focus-visible .ngf-category-arrow {
      background-color: var(--color-champagne);
      color: var(--color-white);
      transform: translateX(2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ngf-category-arrow {
      transition: none;
    }

    .ngf-category-tile:hover .ngf-category-arrow {
      transform: none;
    }
  }
</style>
