---
/**
 * A section whose final copy the operator has not written yet.
 *
 * **What changed and why.** This used to render the operator's own `[PLACEHOLDER — …]` marker
 * verbatim, above a label reading "Awaiting content — homepage.customFurniture.body", on a tinted
 * ground with a champagne rule. That satisfied Requirement 7.10's "visibly distinguished and
 * labelled" reading, and it was the right instinct — never invent a business fact to fill a gap —
 * but it put an internal content key and a developer string in front of paying customers on six
 * pages. A visitor reading "homepage.customFurniture.body" does not conclude "this copy is pending";
 * they conclude the site is broken.
 *
 * So the three obligations are kept, and only the audience changes:
 *
 * 1. **No invented fact.** Still absolute. The prose below is an *invitation* — it asks the visitor
 *    to tell us what they want and promises a reply. It makes no claim about materials, timelines,
 *    capacity, experience, or anything else the operator has not stated. There is nowhere in this
 *    file for a business fact to be written, which is the same guarantee as before.
 * 2. **Listed in the admin content checklist.** Unchanged, and it never depended on this component:
 *    `getPlaceholderKeys()` derives the checklist from `awaitingCopy` in `data/site/homepage.json`,
 *    so the operator's list is identical whether or not the key is printed on the page.
 * 3. **Distinguishable — for the operator, not the customer.** `data-content-key` and
 *    `data-ngf-awaiting-content` are still on the element, so the checklist, an audit script, or a
 *    reviewer with devtools can reconcile page against checklist by inspection. An HTML comment
 *    names the key in the source. None of it is rendered.
 *
 * Requirements: 7.10, 8.4, 8.8.
 * Design: Pages, Navigation, and States → Homepage composition; Open Items item 3.
 */

interface Props {
  /** The operator's placeholder text. Retained for the checklist; never rendered. */
  body: string;
  /** The checklist key this placeholder belongs to, e.g. `homepage.craftsmanship.body`. */
  contentKey: string;
  class?: string;
}

const { body, contentKey, class: className } = Astro.props;

/**
 * The stand-in prose.
 *
 * One sentence, and deliberately about the visitor rather than about us: it commits to answering,
 * which is a promise the operator has already made everywhere else on the site with the two phone
 * numbers, and it commits to nothing else.
 */
const INVITATION =
  'Tell us what you have in mind — the piece, the room it is for, the timber or finish you prefer — and we will come back to you with options, timelines and prices.';

// Retained so the prop is unmistakably part of the contract even though it is not printed. The
// operator's marker lives in the content file; the checklist reads it from there.
void body;
---

<!-- Awaiting operator copy: {contentKey} -->
<div
  class:list={['ngf-placeholder', className]}
  data-content-key={contentKey}
  data-ngf-awaiting-content
>
  <p class="ngf-placeholder-body">{INVITATION}</p>
</div>

<style>
  /*
   * No tinted ground, no champagne rule, no label. The section reads as finished prose, because to a
   * customer that is all it needs to be; the marker for the operator is in the attributes.
   */
  .ngf-placeholder {
    margin: 0;
  }

  .ngf-placeholder-body {
    margin: 0;
    max-width: var(--measure-prose);
    color: var(--color-walnut);
  }
</style>
