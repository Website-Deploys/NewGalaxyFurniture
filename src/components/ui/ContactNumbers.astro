---
/**
 * Both business numbers, with one label.
 *
 * This component exists so that the header, the footer, every PDP, and the contact page
 * cannot drift apart on the one piece of copy Requirement 5.10 constrains. Each row renders
 * the identical label text (`NUMBER_LABEL`) and the numbers are distinguished only by the
 * digits — no "Sales", no "Support", no trailing index.
 *
 * Both channels are offered per number: a WhatsApp link and a `tel:` link, both real `<a>`
 * elements built by the shared URL helpers.
 *
 * Requirements: 5.9, 5.10, 5.11, 5.13, 19.3, 24.3.
 */
import CallLink from '@/components/ui/CallLink.astro';
import WhatsAppLink from '@/components/ui/WhatsAppLink.astro';
import { getSiteSettings } from '@/lib/content/site';
import {
  channelAriaLabel,
  contactChannels,
  NUMBER_LABEL,
  NUMBERS_CAPTION,
} from '@/lib/site/contact';
import type { EnquiryContext } from '@/lib/whatsapp';

interface Props {
  /** The enquiry the WhatsApp links should pre-fill. Defaults to a general enquiry. */
  context?: EnquiryContext;
  /** `stack` for footer/contact columns, `inline` for a single row of chips. */
  layout?: 'stack' | 'inline';
  /** Suppresses the shared caption where the surrounding copy already carries it. */
  showCaption?: boolean;
  class?: string;
}

const {
  context = { kind: 'general' } satisfies EnquiryContext,
  layout = 'stack',
  showCaption = true,
  class: className,
} = Astro.props;

const channels = contactChannels(getSiteSettings());
---

<div class:list={['ngf-numbers', `ngf-numbers-${layout}`, className]}>
  {showCaption && <p class="ngf-numbers-caption">{NUMBERS_CAPTION}</p>}
  <ul class="ngf-numbers-list">
    {
      channels.map((channel) => (
        <li class="ngf-numbers-item">
          {/* The identical label on every row — the distinction is the number. */}
          <span class="ngf-numbers-label">{NUMBER_LABEL}</span>
          <span class="ngf-numbers-value">{channel.display}</span>
          <span class="ngf-numbers-actions">
            {channel.whatsapp && (
              <WhatsAppLink
                context={context}
                number={channel.entry}
                variant="bare"
                label="WhatsApp"
                ariaLabel={channelAriaLabel(channel, 'whatsapp')}
              />
            )}
            {channel.phone && (
              <CallLink
                number={channel.entry}
                variant="bare"
                label="Call"
                ariaLabel={channelAriaLabel(channel, 'call')}
              />
            )}
          </span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .ngf-numbers-caption {
    margin: 0 0 0.75rem;
    font-size: var(--text-small);
    opacity: 0.8;
  }

  .ngf-numbers-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ngf-numbers-inline .ngf-numbers-list {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .ngf-numbers-item {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .ngf-numbers-label {
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-walnut);
    opacity: 0.85;
  }

  /*
   * The number itself, in the editorial display face so it belongs to the same voice as the
   * headings — but set with *proportional* figures rather than `tabular-nums`. Tabular figures
   * force every digit onto the same advance width, which in a serif reads as a mechanical ledger
   * rather than a phone number a person would call; proportional lining figures let the serif set
   * the number the way it sets a heading. It sits a shade below the h3 heading size so it is
   * prominent without shouting, with a hair of positive tracking so the eleven digits stay easy to
   * group and read aloud.
   */
  .ngf-numbers-value {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    font-weight: 500;
    font-variant-numeric: proportional-nums lining-nums;
    letter-spacing: 0.01em;
    line-height: 1.15;
    color: var(--color-obsidian);
  }

  /*
   * The two channel controls sit on their own line, a touch tighter than before so the label,
   * number and actions read as one grouped block per number rather than three loose lines.
   */
  .ngf-numbers-actions {
    display: flex;
    gap: 1rem;
    margin-top: 0.35rem;
  }
</style>
