---
/**
 * The brand mark — and the one swap-in point for the real logo.
 *
 * **No logo asset exists.** That is a fact about this project, not a gap in this component.
 * The design's resolution (Open Items item 1) is implemented here in full:
 *
 * - `settings.logo.src === null` → the typographic wordmark fallback renders: the business
 *   name in the display serif, letterspaced small caps, over a champagne hairline rule.
 * - `settings.logo.src` set to a path → that asset renders instead, at the same optical
 *   size, and the wordmark disappears.
 *
 * Swapping in the real mark is therefore **one file drop plus one settings field**, with no
 * change to this or any other component. Nothing here draws a substitute mark, monogram, or
 * glyph: an invented logo is worse than an honest wordmark because it looks final.
 *
 * The wordmark text comes from `logo.wordmarkFallback` rather than `businessName` so the
 * operator can adjust the lockup's wording (line breaks, an ampersand) without renaming the
 * business everywhere else.
 *
 * Requirements: 19.4, 19.5.
 * Design: Pages, Navigation, and States → Navigation; Open Items item 1.
 */
import { getSiteSettings } from '@/lib/content/site';
import { loadingAttributes } from '@/lib/images/staging';

interface Props {
  /** `sm` for the mobile bar and footer, `md` for the header, `lg` for the hero. */
  size?: 'sm' | 'md' | 'lg';
  /** `light` for dark surfaces, `dark` for ivory surfaces. */
  tone?: 'light' | 'dark';
  /** Wraps the mark in a link to the homepage. Off inside an existing link. */
  href?: string | null;
  class?: string;
}

const { size = 'md', tone = 'dark', href = '/', class: className } = Astro.props;

const settings = getSiteSettings();
const src = settings.logo.src;
const width = settings.logo.width ?? null;
const height = settings.logo.height ?? null;
const wordmark = settings.logo.wordmarkFallback;
const assetLoading = loadingAttributes();
const Wrapper = href === null ? 'span' : 'a';
const wrapperProps = href === null ? {} : { href, 'aria-label': `${settings.businessName} home` };
---

<Wrapper
  {...wrapperProps}
  class:list={['ngf-brand', `ngf-brand-${size}`, `ngf-brand-${tone}`, className]}
  data-brand-source={src === null ? 'wordmark' : 'asset'}
>
  {
    src === null ? (
      /*
        The fallback. A `<span>` rather than an SVG so it inherits the loaded display face and
        needs no asset of its own; `aria-label` on the wrapper already names it, so the visual
        text is the accessible text and nothing is duplicated to a screen reader.

        The words are separate spans so the lockup can wrap between them on a narrow header
        instead of forcing a horizontal scrollbar. "NEW GALAXY FURNITURE" letterspaced is ~230 px
        at header size, which does not fit beside a search control, an enquiry control and a menu
        control at 320 px — and shrinking the type to ~8 px to make it fit would be worse than
        stacking it. Wrapping is opt-in per surface (see `.ngf-header-brand` in shell.css); the
        desktop header and the hero keep it on one line.
      */
      <span class="ngf-brand-wordmark">
        {wordmark
          .split(/\s+/)
          .filter((word) => word !== '')
          .map((word) => (
            <span class="ngf-brand-word">{word}</span>
          ))}
      </span>
    ) : (
      /*
        The supplied asset. `width`/`height` come from Settings, where the schema makes them
        mandatory as soon as `src` is set, so the header's box is reserved before the file arrives
        rather than shifting sideways when it does. It is not the page's largest contentful element
        on any route, so it loads like everything else that is not: deferred, decoded off the
        critical path.

        The mark is a full lockup on a cream ground (the monogram over the "New Galaxy Furniture"
        wordmark). It is a *portrait* asset, so it is contained inside a size-appropriate box rather
        than sized by height alone: a tall canvas scaled to a 32 px header height rendered ~26 px
        wide — technically present, visually absent. The box gives it real presence and the canvas
        reads as part of the ivory surface, so no empty rectangle floats in the header.

        `data-fade` opts the asset into the restrained one-shot opacity reveal defined below: it
        fades up once on load and holds, with no movement, and is fully visible immediately under
        reduced motion, `[data-motion='off']`, or with no JavaScript.
      */
      <span class="ngf-brand-frame" data-fade>
        <img
          src={src}
          alt={settings.businessName}
          class="ngf-brand-asset"
          {...(width === null ? {} : { width })}
          {...(height === null ? {} : { height })}
          loading={assetLoading.loading}
          decoding={assetLoading.decoding}
        />
      </span>
    )
  }
</Wrapper>

<style>
  .ngf-brand {
    display: inline-flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  /*
    The column gap is the vertical rhythm between the wordmark's lettering and the champagne
    hairline beneath it. It belongs to the wordmark lockup only; the supplied asset is a single
    child, so an inherited column gap there is dead space that pads the header for no reason.
  */
  .ngf-brand[data-brand-source='wordmark'] {
    gap: 0.375rem;
  }

  /*
   * The wordmark is a link to the homepage, so on touch it owes the same 44 px as any other control
   * (Requirement 24.3). Its own type sets its height — around 30 px at the sizes the header and
   * footer use — which is a comfortable click and a missable tap. `justify-content: center` keeps the
   * lettering optically where it was; only the hit area grows.
   */
  @media (max-width: 767px) {
    .ngf-brand {
      min-height: 44px;
      justify-content: center;
    }
  }

  .ngf-brand-wordmark {
    display: flex;
    flex-wrap: nowrap; /* surfaces that need wrapping opt in — see shell.css */
    column-gap: 0.45em;
    row-gap: 0.1em;
    font-family: var(--font-display);
    font-weight: 500;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.22em;
    line-height: 1.05;
    text-transform: lowercase; /* with all-small-caps this yields even small capitals */
  }

  .ngf-brand-word {
    white-space: nowrap;
  }

  /*
    The champagne hairline — the one place the accent is used as a rule rather than text. It belongs
    to the typographic fallback only: once the real asset is dropped in, the mark carries its own
    design and a rule underneath it would be a decoration nobody asked for.
  */
  .ngf-brand[data-brand-source='wordmark']::after {
    content: '';
    display: block;
    height: 1px;
    margin-top: 0.375rem;
    background-color: var(--color-champagne);
  }

  .ngf-brand-sm .ngf-brand-wordmark {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
  }

  .ngf-brand-md .ngf-brand-wordmark {
    font-size: 1rem;
  }

  .ngf-brand-lg .ngf-brand-wordmark {
    font-size: clamp(1.25rem, 3vw, 2rem);
  }

  .ngf-brand-light {
    color: var(--color-ivory);
  }

  .ngf-brand-dark {
    color: var(--color-obsidian);
  }

  /*
   * The asset frame. A fixed box the mark is *contained* within, rather than a bare height on a
   * portrait image. `object-fit: contain` keeps the lockup crisp and undistorted; the box height is
   * the header's rhythm and the width is capped so a very tall canvas cannot push the row wide. The
   * cream ground of the artwork sits on the ivory header, so the two read as one surface and there
   * is no floating rectangle.
   */
  .ngf-brand-frame {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
  }

  .ngf-brand-asset {
    display: block;
    width: auto;
    height: 100%;
    max-width: 100%;
    object-fit: contain;
  }

  /* The mobile bar and footer: recognizable but compact. */
  .ngf-brand-sm .ngf-brand-frame {
    height: 40px;
    max-width: 132px;
  }

  /*
   * The desktop header: real presence without a tall bar. The asset is the tightly-trimmed lockup
   * (no intrinsic whitespace), so it fills the frame at its natural landscape ratio with a plain
   * `contain` — no scale hack, no clipping.
   */
  .ngf-brand-md .ngf-brand-frame {
    height: 52px;
    max-width: 200px;
  }

  /* The hero: the largest lockup, still contained so the wordmark stays legible. */
  .ngf-brand-lg .ngf-brand-frame {
    height: 72px;
    max-width: 240px;
  }

  @media (min-width: 1024px) {
    .ngf-brand-md .ngf-brand-frame {
      height: 56px;
      max-width: 216px;
    }
  }

  /*
   * The restrained premium reveal: opacity only, once, no movement. The DRAWN (visible) state is the
   * default, so with no JavaScript, under reduced motion, or with the motion toggle off the mark is
   * simply present. The from-state lives only inside the no-preference gate.
   */
  .ngf-brand-frame[data-fade] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global([data-motion='off']) .ngf-brand-frame[data-fade] {
      opacity: 1;
      animation: none;
    }

    .ngf-brand-frame[data-fade] {
      animation: ngf-brand-fade var(--dur-reveal) var(--ease-entrance) both;
    }
  }

  @keyframes ngf-brand-fade {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }
</style>
