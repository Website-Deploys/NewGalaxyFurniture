---
/**
 * The WhatsApp affordance. A real `<a>`, never a button with a click handler.
 *
 * That distinction is the whole requirement (5.11): a link carries its destination in
 * its own `href`, so long-press, middle-click, "copy link address", and open-in-new-tab
 * all resolve to exactly what activation resolves to. A `<button onclick=…>` looks
 * identical and fails every one of those, which on mobile — where long-press to share a
 * product enquiry is a real behaviour — silently loses conversions.
 *
 * Because it is a plain link with `target="_blank"`, activating it also cannot disturb the
 * current page: scroll position, active filters, search text, and gallery position are
 * untouched (5.12). Nothing here runs JavaScript, so there is nothing that *could*
 * disturb them.
 *
 * The URL is built by `buildWhatsAppUrl` from `buildEnquiryMessage` — the same pure
 * functions the property tests cover — so no surface can hand-roll a `wa.me` URL and get
 * the single-encoding rule wrong.
 *
 * Requirements: 5.1–5.8, 5.11, 5.12, 5.13, 24.3.
 * Design: Conversion → Message and URL construction.
 */
import { getSiteSettings } from '@/lib/content/site';
import { buildEnquiryMessage, buildWhatsAppUrl } from '@/lib/whatsapp';
import type { EnquiryContext } from '@/lib/whatsapp';
import type { ContactNumberValue } from '@/schemas/site';

interface Props {
  /** What the visitor is enquiring about. Determines the pre-filled message. */
  context: EnquiryContext;
  /** Which stored number to send to. Defaults to the first WhatsApp number. */
  number?: ContactNumberValue;
  /** Visible text. Defaults to a neutral label; the slot overrides it entirely. */
  label?: string;
  /**
   * `solid` — filled obsidian, for the primary CTA.
   * `outline` — hairline border, for secondary placements.
   * `bare` — inherits type styling, for footer and inline lists.
   */
  variant?: 'solid' | 'outline' | 'bare';
  /** An accessible name that differs from the visible label (e.g. per-number rows). */
  ariaLabel?: string;
  class?: string;
}

const settings = getSiteSettings();
const {
  context,
  number = settings.whatsapp[0],
  label = 'Order or Enquire on WhatsApp',
  variant = 'solid',
  ariaLabel,
  class: className,
} = Astro.props;

// `whatsapp` is `.min(1)` in the schema, so this is unreachable for valid settings.
// Rendering nothing beats rendering a link to `https://wa.me/?text=…`.
const href =
  number === undefined
    ? null
    : buildWhatsAppUrl(number.e164, buildEnquiryMessage(context, settings));
---

{
  href !== null && (
    <a
      href={href}
      target="_blank"
      rel="noopener"
      data-ngf-whatsapp
      aria-label={ariaLabel}
      class:list={['ngf-cta', `ngf-cta-${variant}`, className]}
    >
      <svg
        class="ngf-cta-glyph"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="currentColor"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.97L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm5.8 14.03c-.24.68-1.4 1.3-1.94 1.35-.54.06-1.04.08-1.6-.1a13.4 13.4 0 0 1-4.2-2.4 11.3 11.3 0 0 1-2.3-3.1c-.24-.5-.32-.94-.32-1.34 0-.6.3-1.1.72-1.53.16-.16.34-.2.48-.2h.34c.16 0 .32 0 .46.32.16.38.6 1.46.66 1.56.06.1.1.22.02.38-.08.16-.14.26-.26.4l-.2.24c-.1.12-.2.24-.1.44.1.2.48.82 1.02 1.32.7.66 1.28.86 1.48.96.2.1.32.08.44-.04.12-.14.5-.58.64-.78.14-.2.28-.16.46-.1.18.06 1.16.56 1.36.66.2.1.34.14.38.22.04.1.04.52-.14 1.06Z" />
      </svg>
      <span>
        <slot>{label}</slot>
      </span>
    </a>
  )
}

<style>
  /**
   * ≥ 44 px in each dimension (Requirement 24.3), enforced here rather than at each call
   * site so no placement can accidentally ship a 32 px tap target.
   */
  .ngf-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    min-width: 44px;
    padding: 0.625rem 1.25rem;
    border-radius: var(--radius-hair);
    font-size: var(--text-small);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-standard);
  }

  .ngf-cta-solid {
    background-color: var(--color-obsidian);
    color: var(--color-ivory);
  }

  .ngf-cta-outline {
    border: 1px solid currentColor;
    color: var(--color-espresso);
  }

  .ngf-cta-bare {
    min-height: 44px;
    padding: 0.5rem 0;
    color: inherit;
    font-weight: 400;
  }

  @media (hover: hover) {
    .ngf-cta-solid:hover {
      background-color: var(--color-espresso);
    }

    .ngf-cta-outline:hover {
      background-color: var(--color-cream);
    }
  }

  .ngf-cta-glyph {
    flex: none;
  }
</style>
