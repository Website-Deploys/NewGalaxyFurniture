---
/**
 * The public site footer.
 *
 * It carries the same category destinations as the header, both business numbers with the one
 * shared label, and the supporting pages (Requirement 9.7). Social links render **only where
 * settings hold a non-null value** — a dead icon that links nowhere is worse than no icon
 * (Requirement 19.6), and the same rule governs the address block: it appears only once
 * settings supply address lines.
 *
 * The reduce-motion toggle (Requirement 21.13) lives here because a footer is where a visitor
 * looks for a site-level preference. It writes `data-motion` on `<html>` and persists it to
 * `localStorage`; `global.css` already suppresses animation for `[data-motion='off']`, and
 * `BaseLayout` restores the attribute before first paint so the setting never flashes.
 *
 * Requirements: 9.7, 19.4, 19.6, 21.13, 24.12.
 */
import BrandMark from '@/components/ui/BrandMark.astro';
import ContactNumbers from '@/components/ui/ContactNumbers.astro';
import { getSiteSettings } from '@/lib/content/site';
import { CATEGORY_NAV, POLICY_NAV, SUPPORT_NAV } from '@/lib/site/navigation';

const settings = getSiteSettings();

// Only non-null social values become links.
const social = Object.entries(settings.social).filter(
  (entry): entry is [string, string] => typeof entry[1] === 'string' && entry[1] !== '',
);

const addressLines = settings.location.addressLines.filter((line) => line.trim() !== '');
const cityState = [settings.location.city, settings.location.state]
  .filter((part) => part.trim() !== '')
  .join(', ');
const serviceArea = settings.serviceArea.filter((area) => area.trim() !== '');
const year = new Date().getFullYear();
---

<footer class="ngf-footer">
  <div class="ngf-footer-inner">
    <div class="ngf-footer-brand">
      <BrandMark size="md" tone="dark" href="/" />
      <p class="ngf-footer-line">
        Furniture manufacturer and showroom{cityState === '' ? '' : `, ${cityState}`}{
          serviceArea.length === 0 ? '' : ` · Serving ${serviceArea.join(', ')}`
        }.
      </p>
      {
        addressLines.length > 0 && (
          <address class="ngf-footer-address">
            {addressLines.map((line) => (
              <span>{line}</span>
            ))}
          </address>
        )
      }
    </div>

    <nav class="ngf-footer-col" aria-label="Categories">
      <h2 class="ngf-footer-heading">Categories</h2>
      <ul>
        {
          CATEGORY_NAV.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="ngf-footer-col" aria-label="Company">
      <h2 class="ngf-footer-heading">Company</h2>
      <ul>
        {
          SUPPORT_NAV.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ngf-footer-col">
      <h2 class="ngf-footer-heading">Orders &amp; enquiries</h2>
      {/* Both numbers, one label, both channels. */}
      <ContactNumbers layout="stack" />
      {
        settings.location.mapUrl !== null && (
          <p>
            <a href={settings.location.mapUrl} rel="noopener">
              Find us on the map
            </a>
          </p>
        )
      }
      {
        social.length > 0 && (
          <ul class="ngf-footer-social">
            {social.map(([name, url]) => (
              <li>
                <a href={url} rel="noopener">
                  {name}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>

  <div class="ngf-footer-base">
    <p>© {year} {settings.businessName}</p>
    <nav aria-label="Policies">
      <ul>
        {
          POLICY_NAV.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button type="button" class="ngf-motion-toggle" data-ngf-motion-toggle aria-pressed="false">
      <span>Reduce motion</span>
    </button>
  </div>
</footer>

<script>
  /**
   * The visitor-facing reduce-motion toggle (Requirement 21.13).
   *
   * It ORs with the OS preference rather than overriding it: turning the toggle *off* while the
   * OS asks for reduced motion must not start animating things. So the button only ever adds
   * `data-motion="off"`; removing it returns control to the media query, which `global.css`
   * honours independently.
   */
  const KEY = 'ngf:motion';
  const button = document.querySelector<HTMLButtonElement>('[data-ngf-motion-toggle]');
  if (button !== null) {
    const apply = (off: boolean): void => {
      document.documentElement.dataset.motion = off ? 'off' : 'auto';
      button.setAttribute('aria-pressed', off ? 'true' : 'false');
    };
    apply(document.documentElement.dataset.motion === 'off');
    button.addEventListener('click', () => {
      const next = document.documentElement.dataset.motion !== 'off';
      apply(next);
      try {
        window.localStorage.setItem(KEY, next ? 'off' : 'auto');
      } catch {
        // A blocked store means the preference lasts for this page only.
      }
    });
  }
</script>
