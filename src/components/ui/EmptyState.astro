---
/**
 * The composed empty state.
 *
 * Requirement 26.14 lists seven states that need one — no products, no search results, no filter
 * matches, no reviews, no leads, no images, no analytics — and the design says none of them may
 * render as "a bare 'nothing here'". Seven separate compositions would guarantee that five of them
 * rot, so there is one primitive: an illustration, a message, and a next action.
 *
 * The three parts are slots rather than props precisely because the *next action* differs at every
 * call site — a visitor with no search results wants category shortcuts, an operator with no images
 * wants the drop zone — while the composition, the spacing, and the tone must not.
 *
 * The default illustration is a hairline drawing marked `aria-hidden`: it carries no information,
 * and a screen-reader visitor gets the heading and the message, which do. Task 19 swaps it for the
 * animated motion primitive without touching this composition.
 *
 * Requirements: 26.12, 26.14.
 * Design: Error Handling → Empty states.
 */

interface Props {
  heading: string;
  message: string;
  /** `page` centres the state in a full-width band; `inline` sits inside a column. */
  tone?: 'page' | 'inline';
  class?: string;
}

const { heading, message, tone = 'inline', class: className } = Astro.props;
---

<div class:list={['ngf-emptystate', className]} data-tone={tone} data-ngf-empty-state>
  {
    Astro.slots.has('illustration') ? (
      <slot name="illustration" />
    ) : (
      <svg
        class="ngf-emptystate-figure"
        viewBox="0 0 96 64"
        width="96"
        height="64"
        fill="none"
        stroke="currentColor"
        stroke-width="1.25"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M8 52V22a4 4 0 0 1 4-4h72a4 4 0 0 1 4 4v30" />
        <path d="M8 52h80" />
        <path d="M24 52v8M72 52v8" />
        <path d="M30 18v-6h36v6" />
      </svg>
    )
  }

  <h2 class="ngf-emptystate-heading">{heading}</h2>
  <p class="ngf-emptystate-message">{message}</p>

  {
    Astro.slots.has('action') && (
      <div class="ngf-emptystate-actions">
        <slot name="action" />
      </div>
    )
  }

  <slot />
</div>

<style>
  /*
   * Scoped rather than global: several of the seven call sites are admin surfaces that do not load
   * the public shell's stylesheet, and an empty state that loses its composition inside the admin
   * application is the same defect in a different room.
   */
  .ngf-emptystate {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding: 3rem 1.5rem;
    border: 1px solid var(--color-taupe);
    background-color: var(--color-white);
  }

  .ngf-emptystate[data-tone='page'] {
    align-items: center;
    padding-block: clamp(3rem, 8vh, 6rem);
    text-align: center;
  }

  .ngf-emptystate-figure {
    color: var(--color-taupe);
  }

  .ngf-emptystate-heading {
    margin: 0;
    font-size: var(--text-h3);
  }

  .ngf-emptystate-message {
    margin: 0;
    color: var(--color-espresso);
  }

  .ngf-emptystate-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
