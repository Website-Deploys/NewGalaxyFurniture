---
/**
 * The loading placeholder.
 *
 * Requirement 26.12 asks for "a placeholder shaped like the expected content", never a blank page,
 * and 26.13 requires it to hold still under reduced motion. Both are structural rather than
 * decorative, so they live in one component:
 *
 * - **Shaped like the content.** The variant decides the shape — a card has a media box and two
 *   text lines, a row is a thumbnail beside its lines, an image is a reserved box at the caller's
 *   aspect ratio. A generic grey rectangle is not a content-shaped placeholder and is what this
 *   exists to prevent.
 * - **The shimmer is a `background-position` animation, and it is switched off under reduced
 *   motion** by an explicit rule as well as by the global clamp. What remains is a static tinted
 *   block, which still reads as "loading" without moving.
 *
 * `aria-hidden` plus `role="presentation"`: a skeleton is not content, and announcing four empty
 * cards to a screen reader is worse than announcing nothing. The surface that owns the skeleton
 * owns the live region that says the content is loading.
 *
 * **The rules live in `global.css`, not here.** `Skeleton.tsx` is the same composition for the React
 * islands, and one set of classes serving both is what keeps the two from drifting into different
 * shapes.
 *
 * Requirements: 26.12, 26.13.
 * Design: Error Handling → Loading states.
 */

interface Props {
  variant?: 'text' | 'image' | 'card' | 'row';
  /** Repetitions — four skeleton cards for a four-card grid. */
  count?: number;
  /** Text lines, for the `text`, `card` and `row` variants. */
  lines?: number;
  /** The reserved aspect ratio for `image` and the card's media box. */
  ratio?: string;
  class?: string;
}

const { variant = 'text', count = 1, lines = 2, ratio = '4 / 3', class: className } = Astro.props;

const items = Array.from({ length: Math.max(1, count) }, (_unused, index) => index);
const textLines = Array.from({ length: Math.max(1, lines) }, (_unused, index) => index);
---

<div
  class:list={['ngf-skeleton', className]}
  data-variant={variant}
  role="presentation"
  aria-hidden="true"
  data-ngf-skeleton
>
  {
    items.map(() => (
      <div class="ngf-skeleton-item">
        {(variant === 'image' || variant === 'card' || variant === 'row') && (
          <span class="ngf-skeleton-media ngf-skeleton-fill" style={`aspect-ratio: ${ratio};`} />
        )}
        {variant !== 'image' && (
          <span class="ngf-skeleton-lines">
            {textLines.map((line) => (
              <span
                class="ngf-skeleton-line ngf-skeleton-fill"
                style={line === textLines.length - 1 ? 'width: 60%;' : undefined}
              />
            ))}
          </span>
        )}
      </div>
    ))
  }
</div>
