---
/**
 * /admin/products/new — the manual product creator.
 *
 * The same component as the editor, in `create` mode, so the seven groups of Requirement 13.1
 * are the creation form too and there is no second, thinner "add product" form to keep in step.
 *
 * The skeleton below is a client-side placeholder, not a stored record: the id, slug and SKU on
 * it are never sent anywhere. Identity is generated by the server when the draft is created
 * (Requirement 13.13), and the operator is then moved to the saved product's own URL.
 *
 * Requirements: 12.1, 12.3, 13.1–13.13.
 */
import AdminLayout from '@/layouts/AdminLayout.astro';
import ProductForm from '@/components/admin/ProductForm';
import { can } from '@/lib/auth/permissions';
import { getPublishedCategories } from '@/lib/content/catalogue';
import type { Product } from '@/schemas/product';

export const prerender = false;

const session = Astro.locals.adminSession;
const role = session?.role ?? 'viewer';

const categories = (await getPublishedCategories()).map((category) => ({
  slug: category.slug,
  name: category.name,
  subcategories: category.subcategories,
}));

const now = new Date().toISOString();
/**
 * A form-shaped blank. `id`, `sku` and `slug` are placeholders that satisfy the shared
 * component's type; the create endpoint accepts none of them and generates its own.
 */
const blank: Product = {
  id: 'p_0000000000',
  sku: 'NGF-NEW-000000',
  slug: 'new-product',
  name: '',
  category: '',
  tags: [],
  description: '',
  currency: 'INR',
  price: null,
  // Price-on-enquiry until the operator types an amount — see the note in
  // `buildNewProduct`. The schema requires one of the two, and this is the one that
  // invents no number.
  priceOnEnquiry: true,
  originalPrice: null,
  discount: null,
  stockStatus: 'IN_STOCK',
  madeToOrder: false,
  availableColors: [],
  variants: [],
  images: [],
  featured: false,
  trending: false,
  bestSeller: false,
  newArrival: false,
  relatedProductIds: [],
  status: 'DRAFT',
  published: false,
  keywords: [],
  createdAt: now,
  updatedAt: now,
  aiAssisted: false,
  aiFields: [],
};
---

<AdminLayout title="Add a product" heading="Add a product">
  <p class="mb-6 max-w-[var(--measure-prose)] text-body text-walnut">
    A name and a category are enough to start. The product is saved as a draft — invisible to
    customers — and you can fill in the rest, add photographs and publish whenever it is ready.
    Nothing on this form needs the AI assistant.
  </p>

  <ProductForm
    client:load
    mode="create"
    product={blank}
    categories={categories}
    canWrite={can(role, 'product.write')}
    canPublish={can(role, 'product.publish')}
    canDelete={can(role, 'product.delete')}
  />
</AdminLayout>
