---
/**
 * `/workshop`.
 *
 * The page whose whole subject — how the furniture is made — is the thing that has not been supplied.
 * Requirement 7.10 forbids stating any manufacturing process, timeline, capability, or business
 * achievement the operator has not supplied, and Requirement 23.17 asks for genuine location content.
 * Both are satisfied the same way: the page states that furniture is made in Bengaluru (which is
 * established) and carries a visible placeholder where the process description goes (which is not).
 *
 * There is deliberately no paragraph here about seasoned timber, mortise-and-tenon joinery, hand-
 * rubbed finishes, or curing times. Every one of those would be plausible and none of them has been
 * confirmed. Milestone 3, Checkpoint D relights the page as an architectural/editorial workshop
 * story: a scroll-linked sequence of technical DRAWINGS on the shared `.ngf-process` drawing-board
 * panels — a sofa, a bed, a dining table and a chair, each drawn in line as a silhouette study —
 * with NO fabricated photographs. Every illustration is one of the four REUSED furniture primitives
 * (sofa, bed, table, chair), which are the four the site would otherwise render nowhere; the page
 * therefore both stays at exactly four distinct `data-ngf-primitive` names AND keeps the site's
 * nine-illustration set complete (Requirement 21.5). Every sequence is a single `data-motion-group`
 * reveal that stays visible-by-default so a broken script can never hide the content.
 *
 * Requirements: 7.10, 8.1, 8.8, 21.15, 23.17.
 */
import PlaceholderCopy from '@/components/home/PlaceholderCopy.astro';
import AnimatedBed from '@/components/motion/AnimatedBed.astro';
import AnimatedChair from '@/components/motion/AnimatedChair.astro';
import AnimatedSofa from '@/components/motion/AnimatedSofa.astro';
import AnimatedTable from '@/components/motion/AnimatedTable.astro';
import CallLink from '@/components/ui/CallLink.astro';
import WhatsAppLink from '@/components/ui/WhatsAppLink.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSiteSettings } from '@/lib/content/site';
import { pageMeta } from '@/lib/seo/page';
import '@/styles/editorial.css';

const settings = getSiteSettings();

/**
 * What the workshop builds, as a sequence of line-drawn silhouette studies. Each stage is a
 * drawing-board panel holding one reused furniture primitive, so the page stays at exactly four
 * distinct `data-ngf-primitive` names and the site's nine-illustration set stays complete. The copy
 * names no process, material, tolerance or timeline — it describes the *drawing* and the kind of
 * piece, which are the honest things this page can show.
 */
const stages = [
  {
    step: '01',
    title: 'Sofas',
    copy: 'A sofa drawn in line — the frame, the arms and the seat, the proportions set before a single length is cut.',
    illustrationTitle: 'A three-seater sofa drawn in line',
  },
  {
    step: '02',
    title: 'Beds',
    copy: 'A bed drawn to its headboard and rails, the piece a room is planned around.',
    illustrationTitle: 'A bed with a headboard drawn in line',
  },
  {
    step: '03',
    title: 'Dining tables',
    copy: 'A dining table drawn top and legs, the surface a home gathers at.',
    illustrationTitle: 'A dining table drawn in line',
  },
  {
    step: '04',
    title: 'Chairs',
    copy: 'A chair drawn seat and back — the piece where proportion is felt most. Ask us to walk you through the making.',
    illustrationTitle: 'A dining chair drawn in line',
  },
] as const;

const meta = pageMeta(Astro, {
  title: 'Workshop',
  description:
    'Where New Galaxy Furniture is made. Our workshop in Bengaluru builds sofas, beds, dining furniture and custom pieces to order.',
  ogType: 'article',
});
---

<BaseLayout meta={meta}>
  <div class="ngf-page">
    <div class="ngf-page-head">
      <p class="ngf-page-eyebrow">The workshop</p>
      <h1>Where the furniture is made</h1>
      <p class="ngf-page-lead">
        {settings.businessName} manufactures in Bengaluru. What leaves the workshop is what we photographed,
        sized and finished ourselves.
      </p>
    </div>

    {/*
      The architectural sequence (Milestone 3, Checkpoint D), reusing the `.ngf-process` drawing-
      board + connecting-line language from `/custom-furniture`. Its own top-level <section> so the
      per-section reveal budget is isolated. The four stages are one [data-reveal][data-motion-group]
      list, so the whole sequence counts as ONE animating element and staggers in as one group.

      Each stage's illustration is a REUSED primitive rendered with trigger="none": it draws its
      final static state, carries no data-reveal of its own, and is titled so it is a meaningful
      role="img" describing the drawing rather than a decorative ornament. There is no photograph
      here, and none is implied — Requirement 7.10 forbids asserting a making the operator has not
      supplied, so the page shows intentional drawings, not stand-in imagery.
    */}
    <section class="ngf-process" aria-labelledby="ngf-workshop-process-heading">
      <h2 id="ngf-workshop-process-heading">What we build, drawn</h2>
      <p class="ngf-process-lead">
        Sofas, beds, dining tables and chairs — the four things the workshop builds, each set out in
        line before it is made.
      </p>

      <ol class="ngf-process-steps" data-reveal data-motion-group>
        <li class="ngf-process-step">
          <div class="ngf-process-panel">
            <span class="ngf-process-glyph">
              <AnimatedSofa strokeWidth={1} trigger="none" title={stages[0].illustrationTitle} />
            </span>
          </div>
          <p class="ngf-process-num" aria-hidden="true">{stages[0].step}</p>
          <h3 class="ngf-process-title">{stages[0].title}</h3>
          <p class="ngf-process-copy">{stages[0].copy}</p>
        </li>

        <li class="ngf-process-step">
          <div class="ngf-process-panel">
            <span class="ngf-process-glyph">
              <AnimatedBed strokeWidth={1} trigger="none" title={stages[1].illustrationTitle} />
            </span>
          </div>
          <p class="ngf-process-num" aria-hidden="true">{stages[1].step}</p>
          <h3 class="ngf-process-title">{stages[1].title}</h3>
          <p class="ngf-process-copy">{stages[1].copy}</p>
        </li>

        <li class="ngf-process-step">
          <div class="ngf-process-panel">
            <span class="ngf-process-glyph">
              <AnimatedTable strokeWidth={1} trigger="none" title={stages[2].illustrationTitle} />
            </span>
          </div>
          <p class="ngf-process-num" aria-hidden="true">{stages[2].step}</p>
          <h3 class="ngf-process-title">{stages[2].title}</h3>
          <p class="ngf-process-copy">{stages[2].copy}</p>
        </li>

        <li class="ngf-process-step ngf-process-step-last">
          <div class="ngf-process-panel">
            <span class="ngf-process-glyph">
              <AnimatedChair strokeWidth={1} trigger="none" title={stages[3].illustrationTitle} />
            </span>
          </div>
          <p class="ngf-process-num" aria-hidden="true">{stages[3].step}</p>
          <h3 class="ngf-process-title">{stages[3].title}</h3>
          <p class="ngf-process-copy">{stages[3].copy}</p>
        </li>
      </ol>
    </section>

    <div class="ngf-page-body">
      <h2>How we make it</h2>
      <PlaceholderCopy
        body="[PLACEHOLDER — describe the making: timber selection and seasoning, joinery, upholstery, finishing, and quality checks, in your own words. No process, material specification, tolerance, or timeline has been supplied, and none has been invented here.]"
        contentKey="page.workshop.body"
      />

      <h2>Visiting</h2>
      <p>
        The showroom address, opening hours and a map link are published on the
        <a href="/contact">contact page</a> as soon as they are confirmed. Until then, call or message
        us and we will arrange a time.
      </p>

      <h2>Made to order</h2>
      <p>
        Most of the catalogue can be built to a size, timber or finish you choose rather than the
        one shown. Start from <a href="/custom-furniture">custom furniture</a> and tell us what the room
        needs.
      </p>

      <div class="ngf-page-actions">
        <WhatsAppLink context={{ kind: 'general' }} />
        <CallLink variant="outline" />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* -------------------------------------------------------------------------- */
  /* The architectural sequence reuses the shared `.ngf-process` language from   */
  /* `/custom-furniture`. The rules below are the same drawing-board panel,      */
  /* connecting line and reduced-motion contract, kept scoped to this page.      */
  /* -------------------------------------------------------------------------- */

  .ngf-process {
    max-width: none;
    margin: 0 0 var(--spacing-section, 4rem);
  }

  .ngf-process > h2 {
    margin: 0;
    font-size: var(--text-h2);
  }

  .ngf-process-lead {
    max-width: var(--measure-prose);
    margin: 0.75rem 0 2rem;
    color: var(--color-walnut);
  }

  .ngf-process-steps {
    display: grid;
    gap: 2rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 640px) {
    .ngf-process-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .ngf-process-steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .ngf-process-step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .ngf-process-panel {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 4 / 3;
    padding: clamp(1rem, 4vw, 1.75rem);
    overflow: hidden;
    border: 1px solid var(--color-taupe);
    border-radius: var(--radius-xl);
    background-color: var(--color-cream);
    background-image:
      linear-gradient(to right, rgb(107 101 92 / 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(107 101 92 / 0.06) 1px, transparent 1px);
    background-position: center;
    background-size: 24px 24px;
    box-shadow: var(--shadow-level1);
  }

  .ngf-process-panel::before,
  .ngf-process-panel::after {
    position: absolute;
    width: 0.6rem;
    height: 0.6rem;
    border: 0 solid var(--color-taupe);
    content: '';
    pointer-events: none;
  }

  .ngf-process-panel::before {
    top: 0.6rem;
    left: 0.6rem;
    border-top-width: 1px;
    border-left-width: 1px;
  }

  .ngf-process-panel::after {
    right: 0.6rem;
    bottom: 0.6rem;
    border-right-width: 1px;
    border-bottom-width: 1px;
  }

  .ngf-process-glyph {
    display: block;
    width: 100%;
    max-width: 200px;
    color: var(--color-walnut);
  }

  .ngf-process-glyph :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .ngf-process-step:not(.ngf-process-step-last)::after {
    content: '';
    position: absolute;
    background-color: var(--color-taupe);
    opacity: 0.7;
    transform: scaleY(1);
    transform-origin: top;
    transition: transform var(--dur-story) var(--ease-draw);
    pointer-events: none;
  }

  .ngf-process-step:not(.ngf-process-step-last)::after {
    left: calc(clamp(1rem, 4vw, 1.75rem));
    top: 100%;
    width: 1px;
    height: 2rem;
    margin-top: -1.5rem;
  }

  @media (min-width: 1024px) {
    .ngf-process-step:not(.ngf-process-step-last)::after {
      top: calc((100% / 3) - 0.5rem);
      left: 100%;
      width: 1.5rem;
      height: 1px;
      margin-top: 0;
      margin-left: -0.75rem;
      transform: scaleX(1);
      transform-origin: left;
    }
  }

  .ngf-process-num {
    margin: 1rem 0 0;
    color: var(--color-champagne);
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .ngf-process-title {
    margin: 0.4rem 0 0;
    font-family: var(--font-display);
    font-size: var(--text-h3);
  }

  .ngf-process-copy {
    margin: 0.5rem 0 0;
    color: var(--color-espresso);
    font-size: var(--text-small);
  }

  @media (prefers-reduced-motion: no-preference) {
    :where(:not([data-motion='off'])) [data-reveal]:not([data-revealed]) .ngf-process-step::after {
      transform: scaleY(0);
    }
  }

  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    :where(:not([data-motion='off'])) [data-reveal]:not([data-revealed]) .ngf-process-step::after {
      transform: scaleX(0);
    }
  }
</style>
