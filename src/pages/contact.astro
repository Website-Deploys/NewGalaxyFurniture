---
/**
 * `/contact`.
 *
 * Requirement 8.5 is a rule about absence: the business location details, both numbers, and a map link
 * appear "each only where the operator has supplied it". So every block on this page is conditional on
 * its own settings value, and there is no fallback copy for any of them — an unsupplied address renders
 * *nothing*, not "Address coming soon" dressed as content and not a plausible Bengaluru address.
 *
 * What is supplied today: both numbers, the address, and the service area. What is not: the geo
 * coordinates and the opening hours. Both are in `SiteSettings.placeholders`, so they are on the admin
 * content checklist (Requirement 8.8). When the address is not supplied a visible notice tells a visitor
 * plainly that it is not published yet rather than leaving them to wonder.
 *
 * Opening hours deserve their own note: there is no `openingHours` field in `SiteSettingsSchema`, the
 * checklist tracks `site.location.openingHours`, and this page therefore states no hours at all. A
 * furniture showroom's hours are exactly the kind of fact a visitor acts on, so guessing them would
 * send someone to a closed door.
 *
 * Requirements: 8.1, 8.5, 8.8, 19.6, 19.7, 23.17.
 */
import EnquiryIsland from '@/components/forms/EnquiryIsland.astro';
import CallLink from '@/components/ui/CallLink.astro';
import WhatsAppLink from '@/components/ui/WhatsAppLink.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSiteSettings } from '@/lib/content/site';
import { localBusinessJsonLd } from '@/lib/seo/jsonld';
import { pageMeta, siteOrigin } from '@/lib/seo/page';
import { channelAriaLabel, contactChannels } from '@/lib/site/contact';
import '@/styles/editorial.css';

const settings = getSiteSettings();
const { location, serviceArea } = settings;

/** The published business numbers, real values from settings. */
const channels = contactChannels(settings);
/**
 * The "Contact us directly" card shows one WhatsApp row and one Call row, each carrying a real
 * number, matching the reference. Both numbers actually reach the same people on both channels,
 * but presenting one per row reads more clearly than repeating the same number twice. Falls back
 * to the single number on both when only one is configured. The rows are built from the shared
 * link components so no surface hand-rolls a messaging or dialer URL (Requirement 5.11).
 */
const whatsappChannel = channels.find((channel) => channel.whatsapp) ?? channels[0];
const callChannel =
  channels.find((channel) => channel.phone && channel !== whatsappChannel) ??
  channels.find((channel) => channel.phone) ??
  channels[0];

const addressLines = location.addressLines.filter((line) => line.trim() !== '');
const localityLine = [location.city, location.state, location.postalCode ?? '']
  .map((part) => part.trim())
  .filter((part) => part !== '')
  .join(', ');
const hasAddress = addressLines.length > 0 || localityLine !== '';

/** `FurnitureStore` on `/contact` as well as `/` — the two pages a visitor looks for it on. */
const meta = pageMeta(Astro, {
  title: 'Contact a Bengaluru Furniture Maker',
  description:
    'Contact New Galaxy Furniture, a furniture manufacturer in Bengaluru serving Karnataka. Both numbers are for orders and enquiries — message on WhatsApp or call.',
  jsonLd: [localBusinessJsonLd(settings, siteOrigin(Astro))],
});
---

<BaseLayout meta={meta}>
  <div class="ngf-page">
    {/* Two columns: the enquiry forms beside the showroom / delivery / direct-contact cards. */}
    <div class="ngf-contact-grid">
      {/* ---- Left: Get in touch + Or ask us to call you ---- */}
      <div class="ngf-contact-card ngf-contact-form-card">
        <h1 id="ngf-contact-form-heading" class="ngf-contact-form-title">Get in touch</h1>
        <EnquiryIsland form="contact" context={{ kind: 'general' }} />

        <hr class="ngf-contact-form-rule" />

        <h2 id="ngf-callback-form-heading" class="ngf-contact-form-title">Or ask us to call you</h2>
        <EnquiryIsland form="callback" context={{ kind: 'general' }} />
      </div>

      {/* ---- Right: three stacked cards ---- */}
      <div class="ngf-contact-side">
        {/* Visit our showroom */}
        <div class="ngf-contact-card">
          <div class="ngf-contact-card-head">
            <span class="ngf-contact-card-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 21s-6-5.2-6-10a6 6 0 1 1 12 0c0 4.8-6 10-6 10Z"></path>
                <circle cx="12" cy="11" r="2.2"></circle>
              </svg>
            </span>
            <div class="ngf-contact-card-headings">
              <h2>Visit our showroom</h2>
              <p class="ngf-contact-card-sub">
                See our furniture, materials and finishes in person.
              </p>
            </div>
          </div>

          <div class="ngf-contact-where">
            <div class="ngf-contact-where-text">
              {
                /* Requirement 8.5: the address renders only where the operator has supplied it. */
                hasAddress ? (
                  <address class="ngf-contact-lines">
                    {addressLines.map((line) => (
                      <span>{line}</span>
                    ))}
                    {localityLine !== '' && <span>{localityLine}</span>}
                  </address>
                ) : (
                  <div class="ngf-policy-notice" role="note" aria-label="Address status">
                    <span class="ngf-policy-notice-label">Address not published yet</span>
                    <p>
                      Our showroom address, opening hours and map link are not published on this
                      site yet. Call or message either number and we will give you the address and a
                      time that suits you.
                    </p>
                  </div>
                )
              }
              {
                location.mapUrl !== null && (
                  <a
                    class="ngf-contact-directions"
                    href={location.mapUrl}
                    target="_blank"
                    rel="noopener"
                  >
                    Get directions
                    <svg
                      viewBox="0 0 16 16"
                      width="14"
                      height="14"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M6 3h7v7M13 3 3 13" />
                    </svg>
                  </a>
                )
              }
            </div>

            {
              /*
              A clickable map thumbnail. It is a same-origin, inline-SVG stylised map — not a
              Google Maps iframe (the CSP forbids frames) and not an off-origin tile image (the CSP
              limits img-src to 'self'). The pin marks the locality the address gives, and the whole
              tile opens the operator's real Google Maps link in a new tab, so the visual is
              decorative while the destination is the genuine map.
            */
              location.mapUrl !== null && (
                <a
                  class="ngf-contact-map"
                  href={location.mapUrl}
                  target="_blank"
                  rel="noopener"
                  aria-label={`Open the New Galaxy Furniture location${location.city.trim() !== '' ? ` in ${location.city.trim()}` : ''} in Google Maps`}
                >
                  <svg
                    class="ngf-contact-map-canvas"
                    viewBox="0 0 240 180"
                    role="img"
                    aria-hidden="true"
                    preserveAspectRatio="xMidYMid slice"
                  >
                    <rect width="240" height="180" fill="#EDE7DD" />
                    <path
                      d="M-10 60 L120 30 L260 70 M-10 120 L100 100 L260 130 M60 -10 L90 90 L70 200 M170 -10 L150 90 L180 200"
                      stroke="#D8CBB6"
                      stroke-width="6"
                      fill="none"
                    />
                    <path
                      d="M-10 88 L110 66 L260 96 M120 -10 L104 92 L128 200"
                      stroke="#C9A15A"
                      stroke-width="3"
                      fill="none"
                      opacity="0.7"
                    />
                    <circle cx="120" cy="86" r="26" fill="#B88A45" opacity="0.14" />
                  </svg>
                  <span class="ngf-contact-map-pin" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="26" height="26" fill="#1C1A18">
                      <path d="M12 22s-7-6.2-7-12A7 7 0 1 1 19 10c0 5.8-7 12-7 12Z" />
                      <circle cx="12" cy="10" r="2.6" fill="#EDE7DD" />
                    </svg>
                  </span>
                  {location.city.trim() !== '' && (
                    <span class="ngf-contact-map-label">{location.city.trim()}</span>
                  )}
                </a>
              )
            }
          </div>
        </div>

        {/* Where we deliver */}
        {
          serviceArea.length > 0 && (
            <div class="ngf-contact-card">
              <div class="ngf-contact-card-head">
                <span class="ngf-contact-card-icon" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    width="20"
                    height="20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M3 6h10v9H3zM13 9h4l3 3v3h-7z" />
                    <circle cx="7" cy="17" r="1.6" />
                    <circle cx="17" cy="17" r="1.6" />
                  </svg>
                </span>
                <div class="ngf-contact-card-headings">
                  <h2>Where we deliver</h2>
                </div>
              </div>
              <p class="ngf-contact-card-lead">
                We manufacture in Bengaluru and deliver and install across {serviceArea.join(', ')}.
              </p>
              <ul class="ngf-contact-deliver">
                <li>
                  <span class="ngf-contact-deliver-dot" aria-hidden="true" />
                  Bengaluru
                </li>
                <li>
                  <span class="ngf-contact-deliver-dot" aria-hidden="true" />
                  Across {serviceArea.join(', ')}
                </li>
                <li>
                  <span class="ngf-contact-deliver-dot" aria-hidden="true" />
                  Delivery &amp; installation
                </li>
              </ul>
              <p class="ngf-contact-card-foot">
                Have a location outside {serviceArea.join(', ')}? Contact us and we will let you
                know.
              </p>
            </div>
          )
        }

        {/* Contact us directly */}
        <div class="ngf-contact-card">
          <div class="ngf-contact-card-head">
            <span class="ngf-contact-card-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M6.5 3h3l1.5 4.5-2 1.5a12 12 0 0 0 5.5 5.5l1.5-2 4.5 1.5v3a2 2 0 0 1-2 2A16 16 0 0 1 4.5 5a2 2 0 0 1 2-2Z" />
              </svg>
            </span>
            <div class="ngf-contact-card-headings">
              <h2>Contact us directly</h2>
              <p class="ngf-contact-card-sub">
                The fastest way to get a price, a photograph, or an honest delivery date is to ask.
                Both numbers are for orders and enquiries.
              </p>
            </div>
          </div>

          <div class="ngf-contact-directs">
            {
              whatsappChannel !== undefined && (
                <WhatsAppLink
                  context={{ kind: 'general' }}
                  number={whatsappChannel.entry}
                  variant="bare"
                  class="ngf-contact-direct"
                  ariaLabel={channelAriaLabel(whatsappChannel, 'whatsapp')}
                >
                  <span class="ngf-contact-direct-label">Order or Enquire on WhatsApp</span>
                  <span class="ngf-contact-direct-value">{whatsappChannel.display}</span>
                  <span class="ngf-contact-direct-arrow" aria-hidden="true">
                    <svg
                      viewBox="0 0 16 16"
                      width="16"
                      height="16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M3 8h10M9 4l4 4-4 4" />
                    </svg>
                  </span>
                </WhatsAppLink>
              )
            }
            {
              callChannel !== undefined && (
                <CallLink
                  number={callChannel.entry}
                  variant="bare"
                  class="ngf-contact-direct"
                  ariaLabel={channelAriaLabel(callChannel, 'call')}
                >
                  <span class="ngf-contact-direct-label">Call us</span>
                  <span class="ngf-contact-direct-value">{callChannel.display}</span>
                  <span class="ngf-contact-direct-arrow" aria-hidden="true">
                    <svg
                      viewBox="0 0 16 16"
                      width="16"
                      height="16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M3 8h10M9 4l4 4-4 4" />
                    </svg>
                  </span>
                </CallLink>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Two-column grid: forms beside the info cards ------------------------- */
  .ngf-contact-grid {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }

  @media (min-width: 960px) {
    .ngf-contact-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 2rem;
    }
  }

  .ngf-contact-side {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Shared card shell ---------------------------------------------------- */
  .ngf-contact-card {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--color-taupe);
    border-radius: var(--radius-xl);
    background-color: var(--color-white);
    box-shadow: var(--shadow-level1);
  }

  /* Left form card ------------------------------------------------------- */
  .ngf-contact-form-title {
    margin: 0 0 1.25rem;
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 400;
    color: var(--color-obsidian);
    line-height: 1.05;
  }

  .ngf-contact-form-rule {
    margin: 2rem 0;
    border: 0;
    border-top: 1px solid var(--color-taupe);
  }

  /* Info-card head: champagne icon circle + heading (+ optional subtitle) - */
  .ngf-contact-card-head {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    margin-bottom: 1rem;
  }

  .ngf-contact-card-icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, var(--color-champagne) 18%, var(--color-white));
    color: var(--color-champagne);
  }

  .ngf-contact-card-headings {
    min-width: 0;
  }

  .ngf-contact-card h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 400;
    color: var(--color-obsidian);
  }

  .ngf-contact-card-sub {
    margin: 0.35rem 0 0;
    color: var(--color-walnut);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .ngf-contact-card-lead {
    margin: 0 0 0.75rem;
    color: var(--color-espresso);
    line-height: 1.55;
  }

  .ngf-contact-card-foot {
    margin: 1rem 0 0;
    font-size: var(--text-small);
    color: var(--color-walnut);
    line-height: 1.5;
  }

  /* Visit our showroom: address beside a wide map thumbnail -------------- */
  .ngf-contact-where {
    display: grid;
    gap: 1.25rem;
    align-items: center;
  }

  @media (min-width: 560px) {
    .ngf-contact-where {
      grid-template-columns: minmax(0, 1fr) minmax(11rem, 14rem);
    }
  }

  .ngf-contact-where-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .ngf-contact-lines {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-style: normal;
    color: var(--color-espresso);
    line-height: 1.55;
  }

  .ngf-contact-directions {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    min-height: 40px;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-taupe);
    border-radius: var(--radius-md);
    color: var(--color-obsidian);
    font-size: var(--text-small);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-standard);
  }

  @media (hover: hover) {
    .ngf-contact-directions:hover {
      background-color: var(--color-cream);
    }
  }

  .ngf-contact-map {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--color-taupe);
    border-radius: var(--radius-md);
    background-color: #ede7dd;
    transition:
      transform var(--dur-fast) var(--ease-standard),
      box-shadow var(--dur-fast) var(--ease-standard);
  }

  @media (hover: hover) {
    .ngf-contact-map:hover {
      transform: translateY(-1px);
      box-shadow: var(--shadow-level1);
    }
  }

  .ngf-contact-map-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ngf-contact-map-pin {
    position: absolute;
    top: 50%;
    left: 50%;
    display: inline-flex;
    transform: translate(-50%, -100%);
    filter: drop-shadow(0 1px 1px rgb(28 26 24 / 0.25));
  }

  .ngf-contact-map-label {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-soft);
    background-color: color-mix(in srgb, var(--color-white) 85%, transparent);
    color: var(--color-obsidian);
    font-size: 0.75rem;
    font-weight: 600;
  }

  /* Where we deliver: inline dot chips ----------------------------------- */
  .ngf-contact-deliver {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .ngf-contact-deliver li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-small);
    color: var(--color-espresso);
  }

  .ngf-contact-deliver-dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-champagne);
  }

  /* Contact us directly: full-width rows ---------------------------------
     The rows are rendered by the shared WhatsAppLink / CallLink components, so each row is an
     `<a class="ngf-cta ngf-cta-bare ngf-contact-direct">` containing the component's own glyph
     `<svg class="ngf-cta-glyph">` followed by a `<span>` wrapping this page's slot. The slot
     carries the label, the number, and the trailing arrow. `:global` reaches the component's
     glyph and wrapper span, which do not carry this file's scope hash. */
  .ngf-contact-directs {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  :global(.ngf-contact-direct.ngf-cta) {
    display: flex;
    width: 100%;
    justify-content: flex-start;
    gap: 0.875rem;
    min-height: 56px;
    padding: 0.875rem 1.125rem;
    border: 1px solid var(--color-taupe);
    border-radius: var(--radius-md);
    background-color: var(--color-cream);
    color: var(--color-obsidian);
    font-weight: 400;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-standard),
      border-color var(--dur-fast) var(--ease-standard);
  }

  @media (hover: hover) {
    :global(.ngf-contact-direct.ngf-cta:hover) {
      background-color: color-mix(in srgb, var(--color-champagne) 12%, var(--color-white));
      border-color: var(--color-champagne);
    }
  }

  /* The component glyph, made into the champagne icon disc the reference shows. */
  :global(.ngf-contact-direct .ngf-cta-glyph) {
    box-sizing: content-box;
    flex: none;
    width: 20px;
    height: 20px;
    padding: 0.5rem;
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, var(--color-champagne) 18%, var(--color-white));
    color: var(--color-champagne);
  }

  /* The wrapper span the component puts the slot in becomes the row's flexing body. */
  :global(.ngf-contact-direct > span) {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    gap: 0.5rem 0.875rem;
    min-width: 0;
  }

  .ngf-contact-direct-label {
    flex: 1 1 auto;
    min-width: 0;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-obsidian);
  }

  .ngf-contact-direct-value {
    flex: none;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    font-variant-numeric: proportional-nums lining-nums;
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: var(--color-obsidian);
  }

  .ngf-contact-direct-arrow {
    display: inline-flex;
    flex: none;
    color: var(--color-walnut);
  }

  /* On very narrow rows the label wraps above the number rather than crushing it. */
  @media (max-width: 420px) {
    .ngf-contact-direct > :global(span) {
      flex-wrap: wrap;
    }

    .ngf-contact-direct-label {
      flex-basis: 100%;
    }
  }
</style>
