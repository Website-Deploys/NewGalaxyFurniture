---
/**
 * `/about`.
 *
 * Two facts about the business are established by the specification itself: New Galaxy Furniture is a
 * Bengaluru-based furniture manufacturer and showroom, and it serves Karnataka. Both are stated here
 * once, naturally, because Requirement 23.17 asks for location signals carried by *genuine content*
 * rather than keyword stuffing — one natural placement per target phrase, well under the 2% density
 * ceiling.
 *
 * Everything else a customer would want on an About page — how long the workshop has run, how many
 * pieces it has made, who works there, what it has won — has not been supplied, and none of it is
 * invented. The `page.about.body` placeholder is where it goes, and it is in the admin content
 * checklist until it arrives (Requirement 8.8).
 *
 * The service area comes from `settings.serviceArea`, so it is the operator's own value rather than
 * this page's assumption.
 *
 * Requirements: 8.1, 8.8, 19.6, 23.17.
 */
import PlaceholderCopy from '@/components/home/PlaceholderCopy.astro';
import CallLink from '@/components/ui/CallLink.astro';
import ImagePreload from '@/components/ui/ImagePreload.astro';
import WhatsAppLink from '@/components/ui/WhatsAppLink.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSiteSettings } from '@/lib/content/site';
import { pageMeta } from '@/lib/seo/page';
import '@/styles/editorial.css';

const settings = getSiteSettings();
const serviceArea = settings.serviceArea.join(', ');

/**
 * The About hero photograph — the New Galaxy Furniture showroom.
 *
 * A real, static editorial asset, pre-optimised into responsive WebP (480–1440 px, ~21–104 KB) and
 * committed under `public/brand/`, so it resolves as a plain same-origin file — the pattern the
 * homepage hero uses, and the one that works under the Lighthouse CI static run (an `astro:assets`
 * URL resolves to Netlify's runtime image endpoint, which is absent from a static `dist`). Modern
 * format, responsive widths and ~67 KB at the rendered size keep the LCP and image audits green.
 *
 * It is this page's single largest contentful image, so it is prioritised and is the one image the
 * page preloads; intrinsic dimensions and the fixed-ratio frame reserve its box against CLS.
 */
const ABOUT_HERO = {
  width: 1672,
  height: 941,
  base: '/brand/about-showroom',
  alt: 'The New Galaxy Furniture showroom in Bengaluru — a beige sofa, walnut coffee table and dining set beneath the words "Furniture that fits your life".',
};
const HERO_WIDTHS = [480, 768, 1040, 1440];
const heroSrc = `${ABOUT_HERO.base}-1040.webp`;
const heroSrcset = HERO_WIDTHS.map(
  (w) => `${ABOUT_HERO.base}-${String(w)}.webp ${String(w)}w`,
).join(', ');
const heroSizes = '(min-width: 768px) 48vw, 100vw';
const heroPreload = { href: heroSrc, srcset: heroSrcset, sizes: heroSizes };

const meta = pageMeta(Astro, {
  title: 'About',
  description:
    'New Galaxy Furniture is a furniture manufacturer in Bengaluru serving Karnataka. Sofas, beds, dining, storage and custom furniture, made to order.',
  ogType: 'article',
});
---

<BaseLayout meta={meta}>
  <ImagePreload slot="head" hint={heroPreload} />
  <div class="ngf-page">
    {
      /*
      The About hero (target design). A copy column — eyebrow, the business name, a one-paragraph
      description, and three claim-free feature badges — beside the showroom photograph. The whole
      hero is one [data-reveal][data-motion-group] so it counts as a single animating element, and
      the photo is the page's one prioritised, preloaded image.

      The three badges state only what the specification already establishes — made to order,
      quality craftsmanship, sustainable materials as a making principle — with no number, date, or
      certification invented.
    */
    }
    <div class="ngf-cathero ngf-abouthero" data-reveal data-motion-group>
      <div class="ngf-cathero-copy">
        <p class="ngf-cathero-eyebrow">About us</p>
        <h1>{settings.businessName}</h1>
        <p class="ngf-page-lead">
          A furniture manufacturer and showroom in Bengaluru, making sofas, beds, dining furniture,
          storage and custom pieces for homes across {serviceArea}.
        </p>

        <ul class="ngf-about-badges" aria-label="What we stand for">
          <li class="ngf-about-badge">
            <span class="ngf-about-badge-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M4 11V8.5A2.5 2.5 0 0 1 6.5 6h11A2.5 2.5 0 0 1 20 8.5V11"></path>
                <path
                  d="M3 11.5A1.5 1.5 0 0 1 4.5 13v3A1.5 1.5 0 0 1 3 17.5M21 11.5A1.5 1.5 0 0 0 19.5 13v3a1.5 1.5 0 0 0 1.5 1.5"
                ></path>
                <path d="M4 16h16M6 18v1.5M18 18v1.5"></path>
              </svg>
            </span>
            <span class="ngf-about-badge-label">Custom made</span>
          </li>
          <li class="ngf-about-badge">
            <span class="ngf-about-badge-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="3"></circle>
                <path
                  d="M12 2v2.5M12 19.5V22M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8 6 18M18 6l1.8-1.8"
                ></path>
              </svg>
            </span>
            <span class="ngf-about-badge-label">Quality craftsmanship</span>
          </li>
          <li class="ngf-about-badge">
            <span class="ngf-about-badge-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M11 20A7 7 0 0 1 18 4c1.5 0 2.5.3 3 .5.2.5.5 1.5.5 3A7 7 0 0 1 4.5 14.5"
                ></path>
                <path d="M5 19c2-4 5-6.5 9-8"></path>
              </svg>
            </span>
            <span class="ngf-about-badge-label">Sustainable materials</span>
          </li>
        </ul>
      </div>

      <figure class="ngf-abouthero-figure">
        <img
          src={heroSrc}
          srcset={heroSrcset}
          sizes={heroSizes}
          alt={ABOUT_HERO.alt}
          width={ABOUT_HERO.width}
          height={ABOUT_HERO.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </div>

    {
      /*
      Orientation first. Three compact facts a customer wants immediately — what we make, where we
      are, how to reach us — as a scannable row rather than three separated paragraphs. Every line
      here is a fact the specification establishes (manufacturer + showroom, Bengaluru, serving the
      operator's service area, both numbers reach us) with nothing invented.
    */
    }
    <section class="ngf-about-facts" aria-label="At a glance" data-reveal data-motion-group>
      <div class="ngf-about-fact">
        <p class="ngf-about-fact-label">What we make</p>
        <p class="ngf-about-fact-body">
          Sofas, beds, dining tables and chairs, storage and custom pieces — the range in our <a
            href="/collection">collection</a
          > is what we build.
        </p>
      </div>
      <div class="ngf-about-fact">
        <p class="ngf-about-fact-label">Where we are</p>
        <p class="ngf-about-fact-body">
          A manufacturer and showroom in Bengaluru, delivering and installing across {serviceArea}.
        </p>
      </div>
      <div class="ngf-about-fact">
        <p class="ngf-about-fact-label">How to order</p>
        <p class="ngf-about-fact-body">
          Message or call us and we reply directly — no marketplace, no reseller in between.
        </p>
      </div>
    </section>

    {
      /*
      What makes the business different. Claim-free positioning the specification already
      establishes — made to order, direct from the workshop, serving the operator's area — and NOT
      any of the facts that have not been supplied: no years, no counts, no certifications, no
      production numbers, no guarantees. Its own <section> so its reveal budget is isolated.
    */
    }
    <section class="ngf-about-values" aria-labelledby="ngf-about-values-heading">
      <h2 id="ngf-about-values-heading">What makes us different</h2>
      <p class="ngf-about-values-lead">
        We are the people who build the furniture, so the answers you get are first-hand.
      </p>
      <ul class="ngf-about-values-list" data-reveal data-motion-group>
        <li class="ngf-about-value">
          <h3>Made to order</h3>
          <p>
            Sizes, timber, finishes and upholstery can be changed on most pieces, and a piece can be
            built to a drawing or a measurement you give us.
          </p>
        </li>
        <li class="ngf-about-value">
          <h3>Direct from the workshop</h3>
          <p>
            There is no reseller between the workshop and your room. Every enquiry on this site
            reaches the people who build the furniture.
          </p>
        </li>
        <li class="ngf-about-value">
          <h3>Serving {serviceArea}</h3>
          <p>
            We manufacture in Bengaluru and deliver and install across {serviceArea}. Ask us what is
            possible for your room.
          </p>
        </li>
      </ul>
    </section>

    {
      /*
      How custom furniture works, and what visiting means — grouped as two clear next steps rather
      than loose paragraphs. Each points to the page that owns the detail, so nothing is duplicated
      or invented here.
    */
    }
    <section
      class="ngf-about-steps"
      aria-label="Custom furniture and visiting"
      data-reveal
      data-motion-group
    >
      <div class="ngf-about-step">
        <h2>Custom furniture</h2>
        <p>
          Most of the catalogue can be built to a size, timber or finish you choose rather than the
          one shown, and a piece can be made to a drawing or a measurement you give us. Start from
          the <a href="/custom-furniture">custom furniture</a> page and tell us what the room needs.
        </p>
      </div>
      <div class="ngf-about-step">
        <h2>Visiting the workshop</h2>
        <p>
          The furniture is made in our Bengaluru workshop — see it drawn out on the <a
            href="/workshop">workshop</a
          > page. Our address, opening hours and a map link appear on the <a href="/contact"
            >contact page</a
          > as soon as they are confirmed; until then, message or call and we will arrange a time.
        </p>
      </div>
    </section>

    {
      /*
      The primary action, made unmistakable: one card, one clear pair of controls. This is the
      obvious CTA the page builds toward.
    */
    }
    <section class="ngf-about-cta" aria-labelledby="ngf-about-cta-heading">
      <div class="ngf-about-cta-inner">
        <div>
          <h2 id="ngf-about-cta-heading">Talk to us</h2>
          <p>
            The fastest way to get a price, a photograph, or an honest delivery date is to ask. Both
            numbers are for orders and enquiries.
          </p>
        </div>
        <div class="ngf-page-actions">
          <WhatsAppLink context={{ kind: 'general' }} variant="solid" />
          <CallLink variant="outline" />
        </div>
      </div>
    </section>

    {
      /*
      Our story, last and quiet. Requirement 8.8 / design Open Items item 1: nothing about the
      workshop's history, scale, or achievements has been supplied, so nothing is claimed. The
      placeholder is visible and labelled rather than filled with plausible copy, and it sits at the
      end so the unbuilt section never dominates the page.
    */
    }
    <section class="ngf-about-story ngf-page-body" aria-labelledby="ngf-about-story-heading">
      <h2 id="ngf-about-story-heading">Our story</h2>
      <PlaceholderCopy
        body="[PLACEHOLDER — the story of the business: when it started, who runs it, and what it has built. No date, scale, capability, or achievement has been supplied, and none has been invented here.]"
        contentKey="page.about.body"
      />
    </section>
  </div>
</BaseLayout>

<style>
  /*
   * One consistent vertical rhythm for the About page's blocks. The sections used to be separated by
   * a full `--spacing-section` (up to 9rem), which stranded each block in its own screen of
   * whitespace; a tighter, uniform gap groups the page into one readable sequence while keeping a
   * premium amount of air between blocks.
   */
  .ngf-about-facts,
  .ngf-about-values,
  .ngf-about-steps,
  .ngf-about-cta,
  .ngf-about-story {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  /* At-a-glance facts row -------------------------------------------------- */

  .ngf-about-facts {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 768px) {
    .ngf-about-facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .ngf-about-fact {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: clamp(1.1rem, 2.5vw, 1.5rem);
    border: 1px solid var(--color-taupe);
    border-radius: var(--radius-lg);
    background-color: var(--color-ivory);
  }

  .ngf-about-fact-label {
    margin: 0;
    color: var(--color-walnut);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ngf-about-fact-body {
    margin: 0;
    color: var(--color-espresso);
    line-height: 1.55;
  }

  .ngf-about-fact-body a {
    color: var(--color-obsidian);
  }

  /* What makes us different ------------------------------------------------ */

  .ngf-about-values > h2 {
    margin: 0;
    font-size: var(--text-h2);
    font-family: var(--font-display);
    font-weight: 400;
  }

  .ngf-about-values-lead {
    margin: 0.5rem 0 0;
    max-width: var(--measure-prose);
    color: var(--color-espresso);
    font-size: var(--text-h3);
    font-family: var(--font-display);
    line-height: 1.35;
  }

  .ngf-about-values-list {
    display: grid;
    gap: 1.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 768px) {
    .ngf-about-values-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .ngf-about-value {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border: 1px solid var(--color-taupe);
    border-radius: var(--radius-xl);
    background-color: var(--color-white);
    box-shadow: var(--shadow-level1);
  }

  .ngf-about-value h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 400;
  }

  .ngf-about-value p {
    margin: 0;
    color: var(--color-espresso);
    font-size: var(--text-small);
    line-height: 1.6;
  }

  /* Custom furniture + visiting (two grouped next steps) ------------------- */

  .ngf-about-steps {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 768px) {
    .ngf-about-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .ngf-about-step {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid var(--color-taupe);
    border-radius: var(--radius-xl);
    background-color: var(--color-white);
    box-shadow: var(--shadow-level1);
  }

  .ngf-about-step h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 400;
  }

  .ngf-about-step p {
    margin: 0;
    color: var(--color-espresso);
    line-height: 1.65;
  }

  .ngf-about-step a {
    color: var(--color-obsidian);
  }

  /* Primary contact CTA ---------------------------------------------------- */

  .ngf-about-cta-inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.75rem, 4vw, 2.5rem);
    border: 1px solid var(--color-taupe);
    border-radius: var(--radius-xl);
    background-color: var(--color-cream);
    box-shadow: var(--shadow-level1);
  }

  @media (min-width: 768px) {
    .ngf-about-cta-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .ngf-about-cta h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 400;
  }

  .ngf-about-cta p {
    margin: 0.5rem 0 0;
    max-width: 46ch;
    color: var(--color-espresso);
    line-height: 1.6;
  }

  .ngf-about-cta .ngf-page-actions {
    flex: none;
  }

  /* Our story (quiet, last) ------------------------------------------------ */

  .ngf-about-story h2 {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 400;
  }

  /* About hero: photo beside the copy, with feature badges -------------------
   *
   * Reuses the shared `.ngf-cathero` two-column grid but swaps the drawing-board panel for the
   * real showroom photograph in a rounded, ratio-reserved frame (so it never shifts the layout —
   * the image-loading audit's rule 5), and adds a row of three claim-free feature badges under the
   * lead paragraph, mirroring the reference.
   */
  @media (min-width: 768px) {
    .ngf-abouthero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      align-items: center;
    }
  }

  .ngf-abouthero {
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .ngf-abouthero-figure {
    margin: 0;
    width: 100%;
    aspect-ratio: 1672 / 941;
    overflow: hidden;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-level2);
  }

  .ngf-abouthero-figure img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Feature badges (Custom made / Quality craftsmanship / Sustainable materials). */
  .ngf-about-badges {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1rem, 3vw, 2rem);
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .ngf-about-badge {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .ngf-about-badge-icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid color-mix(in srgb, var(--color-champagne) 45%, var(--color-taupe));
    border-radius: var(--radius-pill);
    color: var(--color-champagne);
  }

  .ngf-about-badge-label {
    max-width: 8rem;
    color: var(--color-espresso);
    font-size: var(--text-small);
    line-height: 1.3;
  }
</style>
