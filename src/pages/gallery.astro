---
/**
 * `/gallery`.
 *
 * Every photograph the catalogue holds, each one linking to the piece it shows. There is no separate
 * gallery collection on purpose: a second place to upload the same photographs would drift from the
 * first within a month, and a gallery image that does not link to a buyable piece is a dead end.
 *
 * With no photography (design Open Items item 5) the page renders the designed "no images" empty state
 * required by Requirement 26.14 — composed, with a next action, not a blank grid.
 *
 * Requirements: 8.1, 15.17, 26.14.
 */
import CallLink from '@/components/ui/CallLink.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import ImagePreload from '@/components/ui/ImagePreload.astro';
import ResponsiveImage from '@/components/ui/ResponsiveImage.astro';
import WhatsAppLink from '@/components/ui/WhatsAppLink.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCatalogue } from '@/lib/content/catalogue';
import { cardImagePreload } from '@/lib/images/preload';
import { isEagerCard } from '@/lib/images/staging';
import { pageMeta } from '@/lib/seo/page';
import '@/styles/editorial.css';

const products = await getCatalogue();

/** Every image of every Catalogue product, in operator order within each product. */
const tiles = products.flatMap((product) =>
  [...product.images].sort((a, b) => a.order - b.order).map((image) => ({ product, image })),
);

/**
 * The one preloaded image: the first tile, which is this page's largest contentful element. The
 * remaining first-row tiles are eager but not prioritised, and everything below is lazy.
 */
const lead = tiles[0];
const leadPreload = lead === undefined ? null : cardImagePreload(lead.product.id, lead.image);

const meta = pageMeta(Astro, {
  title: 'Gallery',
  description:
    'Photographs of furniture made by New Galaxy Furniture — sofas, beds, dining furniture, storage and custom pieces.',
});
---

<BaseLayout meta={meta}>
  <ImagePreload slot="head" hint={leadPreload} />
  <div class="ngf-page">
    <div class="ngf-page-head">
      <p class="ngf-page-eyebrow">Our work</p>
      <h1>Gallery</h1>
      <p class="ngf-page-lead">
        {
          tiles.length === 0
            ? 'Our pieces are being photographed. Ask us and we will send photographs of comparable work today.'
            : 'Every photograph here is a piece we made. Tap one to see its page.'
        }
      </p>
    </div>

    {
      tiles.length === 0 ? (
        <EmptyState
          tone="page"
          heading="Photography is in progress"
          message="Tell us what you are looking for — a sofa for a particular room, a bed in a particular timber — and we will send photographs of work we have done."
        >
          <WhatsAppLink slot="action" context={{ kind: 'general' }} label="Ask for photographs" />
          <CallLink slot="action" variant="outline" />
        </EmptyState>
      ) : (
        /*
          The lookbook grid (Milestone 3, Checkpoint D). An asymmetric-but-controlled editorial
          rhythm: every third tile runs wide, so the grid reads like a lookbook spread rather than a
          uniform contact sheet. Each tile links to the piece it shows, its image reveals behind a
          clip-path mask (`data-reveal="mask"` — the box never resizes, so loading discipline holds),
          and it lifts a subtle hover zoom on the image alone. The first tile is eager and priority;
          the rest are lazy, and every box reserves its space.
        */
        <ul class="ngf-lookbook">
          {tiles.map((tile, index) => (
            <li class:list={['ngf-lookbook-tile', index % 3 === 0 && 'ngf-lookbook-tile-wide']}>
              <a class="ngf-lookbook-link" href={`/product/${tile.product.slug}`}>
                <span class="ngf-lookbook-frame" data-reveal="mask">
                  <ResponsiveImage
                    productId={tile.product.id}
                    image={tile.image}
                    context="card"
                    eager={isEagerCard(index)}
                    priority={index === 0}
                  />
                </span>
                <span class="ngf-lookbook-caption">{tile.product.name}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

<style>
  /*
   * The lookbook grid. A controlled masonry rhythm: a two-column base on a phone and a three-column
   * track on a wide viewport, where every third tile spans two columns so the spread stays
   * asymmetric without ever breaking the grid.
   */
  .ngf-lookbook {
    display: grid;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 768px) {
    .ngf-lookbook {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .ngf-lookbook-tile-wide {
      grid-column: span 2;
    }
  }

  .ngf-lookbook-tile {
    content-visibility: auto;
    contain-intrinsic-size: auto 20rem;
    min-width: 0;
  }

  .ngf-lookbook-link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--color-obsidian);
    text-decoration: none;
  }

  /*
   * The frame reserves the box and clips the image, so the reveal mask and the hover zoom both play
   * inside a box whose size never changes — the loading discipline the page depends on holds.
   */
  .ngf-lookbook-frame {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-taupe);
    background-color: var(--color-cream);
  }

  .ngf-lookbook-frame > :global(.ngf-image) {
    display: block;
    transition: transform var(--dur-normal, 240ms) var(--ease-entrance, ease);
  }

  @media (prefers-reduced-motion: no-preference) {
    :where(:not([data-motion='off'])) .ngf-lookbook-link:hover .ngf-lookbook-frame > :global(.ngf-image),
    :where(:not([data-motion='off'])) .ngf-lookbook-link:focus-visible .ngf-lookbook-frame > :global(.ngf-image) {
      transform: scale(1.04);
    }
  }

  .ngf-lookbook-caption {
    font-size: var(--text-small);
    color: var(--color-walnut);
  }
</style>
