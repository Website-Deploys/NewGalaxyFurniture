{
  "name": "new-galaxy-furniture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "New Galaxy Furniture — catalogue site on Astro 7 + Preact islands, deployed to Netlify (Functions, Neon Postgres, Netlify Blobs).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run validate:content",
    "build": "astro build",
    "postbuild": "tsx scripts/check-motion-budget.ts && tsx scripts/emit-redirects.ts && tsx scripts/audit-seo.ts && tsx scripts/audit-csp.ts && tsx scripts/audit-page-budget.ts && tsx scripts/audit-image-loading.ts && tsx scripts/lint-keyword-density.ts",
    "preview": "netlify dev",
    "check": "astro check && tsc --noEmit",
    "prelint": "astro sync",
    "lint": "eslint . && prettier --check . && tsx scripts/lint-motion.ts && tsx scripts/audit-error-disclosure.ts && tsx scripts/lint-keyword-density.ts",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "images:migrate": "tsx scripts/migrate-images-to-blobs.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "scan:secrets": "tsx scripts/scan-secrets.ts",
    "size-limit": "size-limit",
    "product:add": "tsx scripts/add-product.ts"
  },
  "dependencies": {
    "@astrojs/netlify": "8.2.6",
    "@astrojs/react": "6.0.5",
    "@cf-wasm/photon": "0.4.0",
    "@jsquash/avif": "2.1.1",
    "@netlify/blobs": "10.7.13",
    "@netlify/neon": "0.1.2",
    "astro": "7.2.10",
    "minisearch": "7.2.0",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@netlify/functions": "^4.2.5",
    "@playwright/test": "1.62.1",
    "@size-limit/file": "13.0.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.2",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.1.0",
    "fast-check": "4.9.0",
    "netlify-cli": "^17.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "size-limit": "13.0.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
