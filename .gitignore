# build output
dist/
.astro/
.wrangler/

# dependencies
node_modules/

# secrets — never commit real values; .env.example is the only tracked env file
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

# test artefacts
.e2e/
design-refs/
preview-screenshots/
playwright-report/
test-results/
coverage/
blob-report/
.playwright/
cookies.txt

# agent/orchestrator scratch and task-state (never commit)
.agents/

# logs / editor / OS
*.log
npm-debug.log*
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Netlify CLI local state. `.netlify` is the CLI's own working folder; `deno.lock` is written when it
# boots its Deno edge-function runtime, which this project does not use — Netlify serves the
# prerendered `dist/client` and nothing else. Neither belongs in the repository.
.netlify
deno.lock
