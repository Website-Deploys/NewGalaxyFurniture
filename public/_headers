# Security headers for everything Cloudflare serves from the asset store.
#
# Prerendered HTML and hashed assets never reach the Worker, so `src/middleware.ts` cannot set
# these for them — this file is the other half of the same policy. The values are NOT authored
# here: `src/lib/security/headers.ts` is the single definition, and
# `tests/unit/security.headers.test.ts` parses this file and fails if any value differs from it.
# Edit the module, then mirror the change here.
#
# `@astrojs/cloudflare` appends its own immutable `Cache-Control` block for `/_astro/*` to the
# copy of this file in `dist/client/`.
#
# Design: Deployment. Requirements: 25.9, 25.10.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-Ya0pUYrC7nM5Cn/056TyVuEiz6dFGrzmkWzgON0pF0U=' 'sha256-BF0290pkb3jxQsE7z00xR8Imp8X34FLC88L0lkMnrGw=' 'sha256-Q2BPg90ZMplYY+FSdApNErhpWafg2hcRRbndmvxuL/Q=' 'sha256-QzWFZi+FLIx23tnm9SBU4aEgx4x8DsuASP07mfqol/c='; connect-src 'self' https://api.whatsapp.com; font-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'

# The pre-paint motion-preference bootstrap is unhashed by necessity (it is referenced by a fixed
# URL from every page), so it revalidates daily instead of being cached immutably.
/ngf-motion-preference.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Fonts are content-stable and referenced by fixed URL; a year with revalidation on change.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable


# The search index is content-hashed into its own filename (`/search-index/{fingerprint}.json`), so
# it can be cached for a year: a catalogue change produces a new filename and the old one is simply
# never requested again. Without this rule the asset store serves it `max-age=0, must-revalidate` —
# a conditional request on every first search intent, on every visit, for a file whose whole design
# is that its URL changes when its contents do. The route handler sets the same value, but a
# prerendered route is served by the asset store and never reaches the handler.
/search-index/*
  Cache-Control: public, max-age=31536000, immutable
