# =============================================================================
#  New Galaxy Furniture — environment variable reference.
#
#  PLACEHOLDER VALUES ONLY. Never commit a real credential to this file or to any
#  other file in the repository (Requirements 28.5, 28.7).
#
#  Local development: copy to `.dev.vars` (gitignored) so `wrangler dev` and
#  `astro dev` load them as Worker bindings.
#      cp .env.example .dev.vars
#
#  Production and preview: set the SECRET block with `wrangler secret put NAME`
#  per environment. Secrets are never read from a file in deployed environments,
#  and never appear in wrangler.toml or in build logs.
# =============================================================================

# -----------------------------------------------------------------------------
# PUBLIC — safe to expose. These are printed on the site itself and are inlined
# into the client bundle by Astro because of the PUBLIC_ prefix.
# -----------------------------------------------------------------------------

# Canonical origin of the deployment. Drives canonical tags, the sitemap, OG URLs
# and JSON-LD, so no hostname is ever hard-coded in source. Preview deployments
# set a distinct value so preview content is never treated as canonical.
PUBLIC_SITE_URL="http://localhost:4321"

# WhatsApp enquiry numbers, in E.164, comma separated, in display order.
# Real numbers for this business: see data/site/settings.json (public information).
PUBLIC_WHATSAPP_NUMBERS="+910000000000,+910000000001"

# Click-to-call numbers, in E.164, comma separated, in display order.
PUBLIC_PHONE_NUMBERS="+910000000000,+910000000001"

# -----------------------------------------------------------------------------
# SECRET — server-side only. The browser must never receive any of these.
# Set with: wrangler secret put NAME
# -----------------------------------------------------------------------------

# Fine-grained GitHub PAT with `contents: write` on the content repository only.
# Used by the Worker → GitHub write pipeline to commit files under data/.
GITHUB_TOKEN="ghp_REPLACE_ME_WITH_A_FINE_GRAINED_TOKEN"

# Repository the write pipeline commits to, as "owner/repo".
GITHUB_REPO="owner/repo"

# Branch content commits land on. Production content commits go to the default
# branch; a build follows unless the commit carries [skip ci].
GITHUB_BRANCH="main"

# AI product assistant. Provider id, API key, and model id — the assistant is
# provider-agnostic and calls the provider only from the Worker.
AI_PROVIDER="anthropic"
AI_API_KEY="sk-REPLACE_ME_WITH_A_PROVIDER_KEY"
AI_MODEL="replace-me-with-a-model-id"

# 32+ bytes of randomness used to sign/derive admin session material.
# Generate with: openssl rand -base64 32
SESSION_SECRET="REPLACE_ME_WITH_32_RANDOM_BYTES_BASE64"

# Optional. Cloudflare deploy hook the Worker can POST to in order to *start* a
# build. Write-only: it reports nothing about a build's outcome.
CF_DEPLOY_HOOK_URL=""

# Optional. Read credentials for GET /api/admin/deploy-status, which reports the
# actual outcome of the build a publish triggered (Requirement 14.12) — the deploy
# hook above cannot, because it only starts builds.
#
# When these are unset the endpoint returns a stable CONFIGURATION_INCOMPLETE and
# the admin UI says "publish committed, deploy status unavailable" rather than
# reporting a false success or a false failure. Nothing else depends on them.
#
# CF_API_TOKEN needs Workers Scripts:Read on the account only.
CF_ACCOUNT_ID=""
CF_API_TOKEN=""
# Worker (script) name whose deployments are polled. Defaults to the wrangler
# `name`, so it only needs setting when the deployed name differs.
CF_WORKER_NAME=""
