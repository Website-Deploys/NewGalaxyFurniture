# =============================================================================
#  New Galaxy Furniture — environment variable reference (Netlify).
#
#  PLACEHOLDER VALUES ONLY. Never commit a real credential to this file or any
#  other file in the repository.
#
#  Local development:
#    cp .env.example .env        # gitignored; `netlify dev` and `astro dev` load it
#    (or set the same values with `netlify env:set NAME value` on a linked site)
#
#  Production / deploy previews:
#    Set every REQUIRED and any OPTIONAL variable in the Netlify site UI
#    (Site configuration → Environment variables) or with `netlify env:set`.
#    Netlify injects them into the build and into every Function's process.env.
#    Secrets are never read from a file in deployed environments.
#
#  There are NO Cloudflare variables. The platform is Netlify only.
# =============================================================================

# -----------------------------------------------------------------------------
# PUBLIC — safe to expose. Printed on the site and inlined into the client
# bundle by Astro because of the PUBLIC_ prefix. Never put a secret here.
# -----------------------------------------------------------------------------

# Canonical origin of the deployment. Drives canonical tags, the sitemap, OG URLs
# and JSON-LD, so no hostname is ever hard-coded in source. Deploy previews set a
# distinct value so preview content is never treated as canonical.
PUBLIC_SITE_URL="http://localhost:8888"

# WhatsApp enquiry numbers, in E.164, comma separated, in display order.
PUBLIC_WHATSAPP_NUMBERS="+910000000000,+910000000001"

# Click-to-call numbers, in E.164, comma separated, in display order.
PUBLIC_PHONE_NUMBERS="+910000000000,+910000000001"

# -----------------------------------------------------------------------------
# REQUIRED (server-only) — the browser must never receive any of these.
# -----------------------------------------------------------------------------

# Neon Postgres connection string. Set automatically by the Netlify Neon / Netlify
# DB integration; set it yourself only for local runs against a Neon branch.
# Used for leads, analytics and admin users. (DATABASE_URL is accepted as a fallback.)
NETLIFY_DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# 32+ bytes of randomness used to derive admin session/CSRF material.
# Generate with: openssl rand -base64 32
SESSION_SECRET="REPLACE_ME_WITH_32_RANDOM_BYTES_BASE64"

# Fine-grained GitHub PAT with `contents: write` on the content repository only.
# Used by the admin → GitHub write pipeline to commit product/content JSON under data/.
GITHUB_TOKEN="ghp_REPLACE_ME_WITH_A_FINE_GRAINED_TOKEN"

# Repository the write pipeline commits to, as "owner/repo".
GITHUB_REPO="owner/repo"

# NOTE: Netlify Blobs (product images, admin sessions, drafts, rate-limit counters)
# needs NO credentials — it is available automatically inside Netlify Functions and
# under `netlify dev`. There is nothing to set here for storage.

# -----------------------------------------------------------------------------
# OPTIONAL (server-only)
# -----------------------------------------------------------------------------

# Branch content commits land on. Defaults to "main" when unset.
GITHUB_BRANCH="main"

# AI product assistant. Provider id (openai | anthropic), API key, and model id.
# When AI_PROVIDER/AI_API_KEY are unset the assistant is simply unavailable and the
# manual product form remains fully usable — no page crashes.
AI_PROVIDER="anthropic"
AI_API_KEY="sk-REPLACE_ME_WITH_A_PROVIDER_KEY"
AI_MODEL="replace-me-with-a-model-id"

# Read credentials for GET /api/admin/deploy-status, which reports the actual outcome
# of the build a publish triggered (Requirement 14.12). When unset the endpoint returns
# a stable CONFIGURATION_INCOMPLETE and the admin UI says "publish committed, deploy
# status unavailable". Nothing else depends on them.
#   NETLIFY_API_TOKEN — a personal access token with read access to the site's deploys.
#   NETLIFY_SITE_ID   — the API ID of the Netlify site.
NETLIFY_API_TOKEN=""
NETLIFY_SITE_ID=""
